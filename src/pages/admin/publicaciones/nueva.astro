---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import ImageUploader from '../../../components/admin/ImageUploader.astro';
import { sessionFromRequest } from '../../../lib/auth';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);
---

<AdminLayout title="Nueva publicación" admin={admin} active="posts">
  <section class="admin-card">
    <h2>Nueva publicación</h2>
    <form
      class="admin-form"
      data-admin-form
      data-endpoint="/api/admin/posts"
      data-success="Publicación creada."
      data-redirect="/admin/publicaciones/"
    >
      <div class="admin-form-row">
        <label>
          <span>Autor</span>
          <input name="author" data-field="author" type="text" maxlength="120" value="Windytech" />
        </label>
        <label>
          <span>Fecha de publicación (opcional)</span>
          <input type="datetime-local" name="publishedAt" data-field="publishedAt" />
        </label>
        <label class="admin-check">
          <input type="checkbox" name="isPublished" data-field="isPublished" data-type="checkbox" />
          Publicada
        </label>
      </div>
      <label>
        <span>Etiquetas (separadas por coma)</span>
        <input name="tags" data-field="tags" data-type="array" type="text" placeholder="seo, automatización" />
      </label>

      <fieldset class="admin-fieldset">
        <legend>Traducciones ES / EN</legend>
        <div class="admin-form-row">
          <label>
            <span>Slug ES</span>
            <input name="tr.es.slug" data-field="tr.es.slug" type="text" required />
          </label>
          <label>
            <span>Slug EN</span>
            <input name="tr.en.slug" data-field="tr.en.slug" type="text" required />
          </label>
        </div>
        <div class="admin-form-row">
          <label>
            <span>Título ES</span>
            <input name="tr.es.title" data-field="tr.es.title" type="text" required />
          </label>
          <label>
            <span>Título EN</span>
            <input name="tr.en.title" data-field="tr.en.title" type="text" required />
          </label>
        </div>
        <div class="admin-form-row">
          <label>
            <span>Extracto ES</span>
            <input name="tr.es.excerpt" data-field="tr.es.excerpt" type="text" maxlength="600" />
          </label>
          <label>
            <span>Extracto EN</span>
            <input name="tr.en.excerpt" data-field="tr.en.excerpt" type="text" maxlength="600" />
          </label>
        </div>
        <div class="admin-form-row">
          <label>
            <span>Contenido ES (Markdown)</span>
            <textarea name="tr.es.bodyMd" data-field="tr.es.bodyMd" rows="6"></textarea>
          </label>
          <label>
            <span>Contenido EN (Markdown)</span>
            <textarea name="tr.en.bodyMd" data-field="tr.en.bodyMd" rows="6"></textarea>
          </label>
        </div>
      </fieldset>

      <ImageUploader mode="single" folder="windytech/publicaciones/nueva" field="coverPublicId" label="Imagen de portada" />

      <p class="admin-message" data-form-message hidden></p>
      <div class="admin-actions">
        <button class="admin-btn" type="submit">Crear publicación</button>
        <a class="admin-btn admin-btn--ghost" href="/admin/publicaciones/">Cancelar</a>
      </div>
    </form>
  </section>
</AdminLayout>
