---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import AdminTable from '../../../components/admin/AdminTable.astro';
import { sessionFromRequest } from '../../../lib/auth';
import { listPostsAdmin } from '../../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);

const posts = await listPostsAdmin();
---

<AdminLayout title="Publicaciones" admin={admin} active="posts"
  crumbs={[{ label: 'Contenido', href: '/admin/proyectos/', icon: 'proyectos' }, { label: 'Publicaciones', icon: 'publicaciones' }]}
>
  <section class="admin-card">
    <header class="admin-actions">
      <a class="admin-btn" href="nueva/">Nueva publicación</a>
    </header>
    <AdminTable
      empty="Sin registros."
      columns={[
    { key: 'numero', label: 'Número' },
    { key: 'titulo', label: 'Título' },
    { key: 'autor', label: 'Autor' },
    { key: 'publicada', label: 'Publicada' },
      ]}
    >
      <table class="admin-table win-table-grid">
      <thead>
        <tr><th data-column="numero" style="width:40px">#</th><th data-column="titulo">Título (ES)</th><th data-column="autor">Autor</th><th data-column="publicada">Publicada</th><th>Acciones</th></tr>
      </thead>
      <tbody>
        {posts.map((post) => (
          <tr>
            <td>{post.id}</td>
            <td>
              <a href={`/admin/publicaciones/${post.id}/`}>{post.title}</a>
            </td>
            <td>{post.author}</td>
            <td>{post.isPublished ? 'Sí' : 'No'}</td>
            <td>
              <a class="admin-btn admin-btn--ghost admin-btn--sm" href={`/admin/publicaciones/${post.id}/`}>Editar</a>
              <button
                class="admin-btn admin-btn--danger admin-btn--sm"
                data-delete={`/api/admin/posts?id=${post.id}`}
                data-confirm="¿Eliminar esta publicación?"
              >
                Eliminar
              </button>
            </td>
          </tr>
        ))}
        {posts.length === 0 && <tr><td colspan="5">Sin publicaciones.</td></tr>}
      </tbody>
      </table>
    </AdminTable>
  </section>
  <script>
    import '../../../scripts/admin-table';
  </script>
</AdminLayout>
