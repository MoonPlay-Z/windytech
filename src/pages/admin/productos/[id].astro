---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import ImageUploader from '../../../components/admin/ImageUploader.astro';
import { sessionFromRequest } from '../../../lib/auth';
import { getProductAdmin, listCategoriesAdmin } from '../../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);

const productId = Number(Astro.params.id);
if (!Number.isInteger(productId) || productId <= 0) return Astro.redirect('/admin/productos/', 302);

const product = await getProductAdmin(productId);
if (!product) return Astro.redirect('/admin/productos/', 302);

const categories = await listCategoriesAdmin();

const translations: any[] = product.translations ?? [];
const esTranslation = translations.find((item: any) => item.locale === 'es') ?? {};
const images: any[] = (product.images ?? []).map((image: any, index: number) => ({ ...image, position: index }));
const specsJson = JSON.stringify(product.specs ?? {}, null, 2);

const priceUsd = (product.priceCents / 100).toFixed(2);
const compareAtUsd = product.compareAtCents != null ? (product.compareAtCents / 100).toFixed(2) : '';
const isNew = product.condition === 'NEW';
const isRefurbished = product.condition === 'REFURBISHED_A';
const isUsed = product.condition === 'USED';
const inStock = product.availability === 'IN_STOCK';
const outOfStock = product.availability === 'OUT_OF_STOCK';
const preorder = product.availability === 'PREORDER';
const costUsd = (product.costCents / 100).toFixed(2);
const shippingUsd = (product.shippingCostCents / 100).toFixed(2);
const deliveryEstimateDaysValue = String(product.deliveryEstimateDays ?? 21);
const ebayItemIdValue = product.ebayItemId ?? '';
const ebayItemUrlValue = product.ebayItemUrl ?? '';
const activeChecked = product.isActive ? 'checked' : '';
const featuredChecked = product.isFeatured ? 'checked' : '';
---
<AdminLayout title="Editar producto" admin={admin} active="products">
  <section class="admin-card">
    <h2>Editar producto</h2>
    <form class="admin-form" data-admin-form data-endpoint="/api/admin/products" data-success="Producto guardado." data-redirect="/admin/productos/">
      <input type="hidden" data-field="id" data-type="number" value={String(productId)} />
      <div class="admin-form-row">
        <label><span>Marca</span><input name="brand" data-field="brand" type="text" value={product.brand} /></label>
        <label><span>Modelo</span><input name="model" data-field="model" type="text" value={product.model} /></label>
        <label>
          <span>Categoría</span>
          <select name="categoryId" data-field="categoryId" data-type="number">
            <option value="">Sin categoría</option>
            {categories.map((category) => (
              <option value={String(category.id)} selected={category.id === product.categoryId}>
                {category.name || `Categoría ${category.id}`}
              </option>
            ))}
          </select>
        </label>
      </div>
      <div class="admin-form-row">
        <label><span>Precio USD</span><input type="number" name="price" data-field="price" data-type="number" min="0" step="0.01" value={priceUsd} /></label>
        <label><span>Precio tachado</span><input type="number" name="compareAt" data-field="compareAt" data-type="number" min="0" step="0.01" value={compareAtUsd} /></label>
        <label><span>SKU</span><input name="sku" data-field="sku" type="text" value={product.sku} /></label>
      </div>
      <div class="admin-form-row">
        <label><span>Costo de adquisición USD</span><input type="number" name="cost" data-field="cost" data-type="number" min="0" step="0.01" value={costUsd} /></label>
        <label><span>% Ganancia reventa</span><input type="number" name="resaleMarginPercent" data-field="resaleMarginPercent" data-type="number" min="0" max="100" step="0.01" value={String(product.resaleMarginPercent ?? 0)} /></label>
        <label><span>Costo envío USD</span><input type="number" name="shipping" data-field="shipping" data-type="number" min="0" step="0.01" value={shippingUsd} /></label>
        <label><span>Días entrega estimados</span><input type="number" name="deliveryEstimateDays" data-field="deliveryEstimateDays" data-type="number" min="1" max="120" value={deliveryEstimateDaysValue} /></label>
      </div>
      <div class="admin-form-row">
        <label>
          <span>Estado eBay</span>
          <select name="ebayStatus" data-field="ebayStatus">
            <option value="draft">Borrador</option>
            <option value="listed">Publicado</option>
            <option value="ended">Retirado</option>
          </select>
        </label>
        <label>
          <span>Item ID eBay</span>
          <input name="ebayItemId" data-field="ebayItemId" type="text" value={ebayItemIdValue} />
        </label>
        <label>
          <span>URL en eBay</span>
          <input name="ebayItemUrl" data-field="ebayItemUrl" type="url" value={ebayItemUrlValue} placeholder="https://www.ebay.com/itm/..." />
        </label>
      </div>
      <div class="admin-form-row">
        <label><span>Condición</span><select name="condition" data-field="condition"><option value="NEW" selected={isNew}>Nuevo</option><option value="REFURBISHED_A" selected={isRefurbished}>Reacondicionado Clase A</option><option value="USED" selected={isUsed}>Usado</option></select></label>
        <label><span>Estado</span><select name="availability" data-field="availability"><option value="IN_STOCK" selected={inStock}>Disponible</option><option value="OUT_OF_STOCK" selected={outOfStock}>Agotado</option><option value="PREORDER" selected={preorder}>Preventa</option></select></label>
        <label class="admin-check"><input type="checkbox" name="isActive" data-field="isActive" data-type="checkbox" checked={activeChecked === 'checked'} /> Activo</label>
        <label class="admin-check"><input type="checkbox" name="isFeatured" data-field="isFeatured" data-type="checkbox" checked={featuredChecked === 'checked'} /> Destacado</label>
      </div>
      <label><span>Especificaciones (JSON)</span><textarea name="specs" data-field="specs" data-type="json" rows="4">{specsJson}</textarea></label>
      <fieldset class="admin-fieldset"><legend>Contenido</legend>
        <div class="admin-form-row">
          <label><span>Slug</span><input name="tr.es.slug" data-field="tr.es.slug" type="text" value={esTranslation.slug ?? ''} /></label>
        </div>
        <div class="admin-form-row">
          <label><span>Nombre</span><input name="tr.es.name" data-field="tr.es.name" type="text" value={esTranslation.name ?? ''} /></label>
        </div>
        <div class="admin-form-row">
          <label><span>Descripción corta</span><input name="tr.es.shortDescription" data-field="tr.es.shortDescription" type="text" maxlength="400" value={esTranslation.shortDescription ?? ''} /></label>
        </div>
        <div class="admin-form-row">
          <label><span>Descripción (Markdown)</span><textarea name="tr.es.descriptionMd" data-field="tr.es.descriptionMd" rows="6">{esTranslation.descriptionMd ?? ''}</textarea></label>
        </div>
        <div class="admin-form-row">
          <label><span>Título SEO</span><input name="tr.es.seoTitle" data-field="tr.es.seoTitle" type="text" maxlength="200" value={esTranslation.seoTitle ?? ''} /></label>
        </div>
        <div class="admin-form-row">
          <label><span>Meta descripción SEO</span><input name="tr.es.seoDescription" data-field="tr.es.seoDescription" type="text" maxlength="320" value={esTranslation.seoDescription ?? ''} /></label>
        </div>
      </fieldset>
      <ImageUploader
        mode="multi"
        folder={`windytech/productos/${productId}`}
        field="images"
        label="Imágenes del producto"
        images={images}
        max={6}
      />
      <p class="admin-message" data-form-message hidden></p>
      <div class="admin-actions">
        <button class="admin-btn" type="submit">Guardar cambios</button>
        <button class="admin-btn" type="button" data-ebay-action="create" data-ebay-product-id={String(productId)}>Publicar en eBay (nuevo)</button>
        <button class="admin-btn" type="button" data-ebay-action="relist" data-ebay-product-id={String(productId)}>Republicar en eBay</button>
        <button class="admin-btn" type="button" data-ebay-action="end" data-ebay-product-id={String(productId)}>Retirar de eBay</button>
      </div>
    </form>
  </section>

  <section class="admin-card">
    <div class="admin-card-heading">
      <div>
        <span class="admin-overline">REDES SOCIALES</span>
        <h2>Tarjeta al compartir el producto</h2>
        <p class="admin-hint">
          Por defecto se comparte la foto principal. Puedes crear una tarjeta con mensaje,
          logo y color de fondo solo para este producto.
        </p>
      </div>
      <a class="admin-btn admin-btn--ghost" href={`/admin/redes-sociales/producto/${productId}/`}>
        Personalizar tarjeta <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</AdminLayout>
