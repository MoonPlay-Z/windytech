---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { sessionFromRequest } from '../../../lib/auth';
import { availabilityLabel } from '../../../lib/admin-labels';
import { listCategoriesAdmin, listProductsAdmin } from '../../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);

const products = await listProductsAdmin();
const categories = await listCategoriesAdmin();
---

<AdminLayout title="Productos" admin={admin} active="products">
  <section class="admin-card" data-ebay-import>
    <header class="admin-card-heading">
      <div>
        <span class="admin-overline">eBay</span>
        <h2>Importar productos desde eBay</h2>
      </div>
      <span class="admin-hint">Se importan con el precio de reventa; puedes publicarlos al catálogo o guardarlos como borrador.</span>
    </header>
    <div class="admin-form">
      <div class="admin-form-row">
        <label>
          <span>Buscar en eBay</span>
          <input type="search" data-ebay-query placeholder="Palabras clave o enlace: https://ebay.io/m/Fd5FrL" />
          <small class="admin-hint">Puedes buscar por texto o pegar el enlace de un producto de eBay.</small>
        </label>
        <label>
          <span>% Ganancia</span>
          <input type="number" data-ebay-margin value="30" min="0" max="100" step="1" />
        </label>
        <label>
          <span>Categoría</span>
          <select data-ebay-category>
            <option value="">Sin categoría</option>
            {categories.map((category) => (
              <option value={String(category.id)}>
                {category.name || `Categoría ${category.id}`}
              </option>
            ))}
          </select>
        </label>
      </div>
      <label class="admin-check">
        <input type="checkbox" data-ebay-activate checked />
        Publicar en el catálogo al importar (desmárcalo para guardarlo como borrador)
      </label>
      <div class="admin-actions">
        <button type="button" class="admin-btn" data-ebay-search>Buscar en eBay</button>
      </div>
    </div>
    <p class="admin-message" data-ebay-message hidden></p>
    <div class="ebay-results" data-ebay-results></div>
    <div class="admin-actions" data-ebay-load-more style="display: none;">
      <button type="button" class="admin-btn admin-btn--ghost" data-ebay-load-more-btn>Ver más resultados</button>
    </div>
  </section>

  <section class="admin-card">
    <header class="admin-actions">
      <a class="admin-btn" href="nuevo/">Añadir producto</a>
    </header>
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width:40px" scope="col">#</th>
          <th scope="col">Producto</th>
          <th scope="col">SKU</th>
          <th scope="col">Precio</th>
          <th scope="col">Estado</th>
          <th scope="col">Activo</th>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {products.map((product) => (
          <tr>
            <td>{product.id}</td>
            <td>
              <a href={`/admin/productos/${product.id}/`}>{product.name}</a>
            </td>
            <td>{product.sku}</td>
            <td>${(product.priceCents / 100).toFixed(2)} USD</td>
            <td>{availabilityLabel(product.availability)}</td>
            <td>{product.isActive ? 'Sí' : 'No'}</td>
            <td>
              <a class="admin-btn admin-btn--ghost admin-btn--sm" href={`/admin/productos/${product.id}/`}>Editar</a>
              <button
                class="admin-btn admin-btn--danger admin-btn--sm"
                data-delete={`/api/admin/products?id=${product.id}`}
                data-confirm="¿Eliminar este producto y sus imágenes?"
              >
                Eliminar
              </button>
            </td>
          </tr>
        ))}
        {products.length === 0 && (
          <tr><td colspan="7">Sin productos.</td></tr>
        )}
      </tbody>
    </table>
  </section>
</AdminLayout>
