---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { sessionFromRequest } from '../../../lib/auth';
import { listCategoriesAdmin } from '../../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);

const categories = await listCategoriesAdmin();
---

<AdminLayout title="Categorías" admin={admin} active="categories">
  <section class="admin-card">
    <header class="admin-actions">
      <a class="admin-btn" href="nueva/">Nueva categoría</a>
    </header>
    <table class="admin-table">
      <thead>
        <tr><th style="width:40px" scope="col">#</th><th scope="col">Nombre (ES)</th><th scope="col">Slug ES</th><th scope="col">Productos</th><th scope="col">Acciones</th></tr>
      </thead>
      <tbody>
        {categories.map((category) => (
          <tr>
            <td>{category.id}</td>
            <td>{category.name}</td>
            <td>{category.slug}</td>
            <td>{category.products}</td>
            <td>
              <div class="admin-actions-cell">
                <a class="admin-btn admin-btn--ghost admin-btn--sm" href={`/admin/categorias/${category.id}/`}>Editar</a>
                <button
                class="admin-btn admin-btn--danger admin-btn--sm"
                data-delete={`/api/admin/categories?id=${category.id}`}
                data-confirm="¿Eliminar esta categoría?"
              >
                Eliminar
              </button>
              </div>
            </td>
          </tr>
        ))}
        {categories.length === 0 && <tr><td colspan="5">Sin categorías.</td></tr>}
      </tbody>
    </table>
  </section>
</AdminLayout>
