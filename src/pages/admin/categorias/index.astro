---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import AdminTable from '../../../components/admin/AdminTable.astro';
import { sessionFromRequest } from '../../../lib/auth';
import { listCategoriesAdmin } from '../../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);

const categories = await listCategoriesAdmin();
---

<AdminLayout title="Categorías" admin={admin} active="categories"
  crumbs={[{ label: 'Catálogo', href: '/admin/productos/', icon: 'productos' }, { label: 'Categorías', icon: 'categorias' }]}
>
  <section class="admin-card">
    <header class="admin-actions">
      <a class="admin-btn" href="nueva/">Nueva categoría</a>
    </header>
    <AdminTable
      empty="Sin registros."
      columns={[
    { key: 'numero', label: 'Número' },
    { key: 'nombre', label: 'Nombre' },
    { key: 'slug', label: 'Slug' },
    { key: 'productos', label: 'Productos' },
      ]}
    >
      <table class="admin-table win-table-grid">
      <thead>
        <tr><th data-column="numero" style="width:40px">#</th><th data-column="nombre">Nombre (ES)</th><th data-column="slug">Slug ES</th><th data-column="productos">Productos</th><th>Acciones</th></tr>
      </thead>
      <tbody>
        {categories.map((category) => (
          <tr>
            <td>{category.id}</td>
            <td>{category.name}</td>
            <td>{category.slug}</td>
            <td>{category.products}</td>
            <td>
              <button
                class="admin-btn admin-btn--danger admin-btn--sm"
                data-delete={`/api/admin/categories?id=${category.id}`}
                data-confirm="¿Eliminar esta categoría?"
              >
                Eliminar
              </button>
            </td>
          </tr>
        ))}
        {categories.length === 0 && <tr><td colspan="5">Sin categorías.</td></tr>}
      </tbody>
      </table>
    </AdminTable>
  </section>
  <script>
    import '../../../scripts/admin-table';
  </script>
</AdminLayout>
