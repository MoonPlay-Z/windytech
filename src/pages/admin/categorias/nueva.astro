---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import ImageUploader from '../../../components/admin/ImageUploader.astro';
import { sessionFromRequest } from '../../../lib/auth';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);
---

<AdminLayout title="Nueva categoría" admin={admin} active="categories"
  crumbs={[{ label: 'Catálogo', href: '/admin/productos/', icon: 'productos' }, { label: 'Categorías', href: '/admin/categorias/', icon: 'categorias' }, { label: 'Nueva categoría' }]}
>
  <section class="admin-card">
    <h2>Nueva categoría</h2>
    <form class="admin-form" data-admin-form data-endpoint="/api/admin/categories" data-success="Categoría guardada." data-redirect="/admin/categorias/">
      <div class="admin-form-row">
        <label>
          <span>Orden</span>
          <input type="number" name="sortOrder" data-field="sortOrder" data-type="number" min="0" value="0" />
        </label>
      </div>
      <div class="admin-form-row">
        <label>
          <span>Slug</span>
          <input name="tr.es.slug" data-field="tr.es.slug" type="text" required />
        </label>
      </div>
      <div class="admin-form-row">
        <label>
          <span>Nombre</span>
          <input name="tr.es.name" data-field="tr.es.name" type="text" required />
        </label>
      </div>
      <div class="admin-form-row">
        <label>
          <span>Descripción</span>
          <input name="tr.es.description" data-field="tr.es.description" type="text" />
        </label>
      </div>
      <ImageUploader mode="single" folder="windytech/categorias" field="imagePublicId" label="Imagen de categoría" />

      <p class="admin-message" data-form-message hidden></p>
      <div class="admin-actions">
        <button class="admin-btn" type="submit">Crear categoría</button>
        <a class="admin-btn admin-btn--ghost" href="/admin/categorias/">Cancelar</a>
      </div>
    </form>
  </section>
</AdminLayout>
