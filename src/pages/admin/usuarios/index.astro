---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import AdminTable from '../../../components/admin/AdminTable.astro';
import { sessionFromRequest } from '../../../lib/auth';
import { requireOwner } from '../../../lib/api';
import { listAdmins } from '../../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);
if (!requireOwner(admin)) return Astro.redirect('/admin/', 302);

const users = await listAdmins();
---

<AdminLayout title="Usuarios" admin={admin} active="users"
  crumbs={[{ label: 'Ajustes', href: '/admin/perfil/', icon: 'ajustes' }, { label: 'Usuarios', icon: 'usuarios' }]}
>
  <section class="admin-card">
    <AdminTable
      empty="Sin registros."
      columns={[
    { key: 'numero', label: 'Número' },
    { key: 'correo', label: 'Correo' },
    { key: 'rol', label: 'Rol' },
    { key: 'activo', label: 'Activo' },
      ]}
    >
      <table class="admin-table win-table-grid">
      <thead>
        <tr>
          <th data-column="numero" style="width:40px">#</th>
          <th data-column="correo">Correo</th>
          <th data-column="rol">Rol</th>
          <th data-column="activo">Activo</th>
          <th style="width:170px">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {users.map((user) => (
          <tr>
            <td>{user.id}</td>
            <td>{user.email}</td>
            <td>{user.role}</td>
            <td>{user.isActive ? 'Sí' : 'No'}</td>
            <td>
              <div class="admin-actions-cell">
                {user.id !== admin.id ? (
                  <button
                    type="button"
                    class="admin-btn admin-btn--outline admin-btn--small"
                    data-reset-password
                    data-user-id={user.id}
                    data-user-email={user.email}
                  >
                    Restablecer clave
                  </button>
                ) : (
                  <span class="admin-text-muted">Tú</span>
                )}
              </div>
            </td>
          </tr>
        ))}
        {users.length === 0 && (
          <tr><td colspan="5">Sin usuarios.</td></tr>
        )}
      </tbody>
      </table>
    </AdminTable>
  </section>
  <script>
    import '../../../scripts/admin-table';
  </script>
</AdminLayout>

<script>
  function initResetPasswords() {
    document.querySelectorAll<HTMLButtonElement>('[data-reset-password]').forEach((button) => {
      if (button.dataset.wtBound === 'true') return;
      button.dataset.wtBound = 'true';

      button.addEventListener('click', async () => {
        const userId = button.dataset.userId;
        const userEmail = button.dataset.userEmail;
        if (!userId) return;

        const original = button.textContent;
        button.disabled = true;
        button.textContent = 'Restableciendo...';

        try {
          const response = await fetch(`/api/admin/users/${userId}/password`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
          });
          const data = await response.json();

          if (!response.ok || !data.success) {
            throw new Error(data.error || 'No se pudo restablecer la clave.');
          }

          alert(
            `Nueva contraseña temporal para ${userEmail}:\n${data.temporaryPassword}\n\nCompártesela al usuario.`,
          );
        } catch (error) {
          alert(error instanceof Error ? error.message : 'Error inesperado.');
        } finally {
          button.disabled = false;
          button.textContent = original;
        }
      });
    });
  }

  function boot() {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initResetPasswords, { once: true });
    } else {
      initResetPasswords();
    }
    document.addEventListener('astro:page-load', initResetPasswords);
  }

  boot();
</script>
