---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { sessionFromRequest } from '../../../lib/auth';
import { requireOwner } from '../../../lib/api';
import { listAdmins } from '../../../lib/db/queries';
import { roleLabel } from '../../../lib/admin-labels';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);
if (!requireOwner(admin)) return Astro.redirect('/admin/', 302);

const users = await listAdmins();
---

<AdminLayout title="Usuarios" admin={admin} active="users">
  <section class="admin-card">
    <p class="admin-message" data-reset-message hidden></p>
    <header class="admin-actions">
      <a class="admin-btn" href="nuevo/">Nuevo usuario</a>
    </header>
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width:40px" scope="col">#</th>
          <th scope="col">Correo</th>
          <th scope="col">Rol</th>
          <th scope="col">Activo</th>
          <th style="width:170px" scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {users.map((user) => (
          <tr>
            <td>{user.id}</td>
            <td>{user.email}</td>
            <td>{roleLabel(user.role)}</td>
            <td>{user.isActive ? 'Sí' : 'No'}</td>
            <td>
              <div class="admin-actions-cell">
                <a class="admin-btn admin-btn--ghost admin-btn--small" href={`/admin/usuarios/${user.id}/`}>Editar</a>
                {user.id !== admin.id ? (
                  <button
                    type="button"
                    class="admin-btn admin-btn--outline admin-btn--small"
                    data-reset-password
                    data-user-id={user.id}
                    data-user-email={user.email}
                  >
                    Restablecer clave
                  </button>
                ) : (
                  <span class="admin-text-muted">Tú</span>
                )}
              </div>
            </td>
          </tr>
        ))}
        {users.length === 0 && (
          <tr><td colspan="5">Sin usuarios.</td></tr>
        )}
      </tbody>
    </table>
  </section>
</AdminLayout>

<script>
  function initResetPasswords() {
    document.querySelectorAll<HTMLButtonElement>('[data-reset-password]').forEach((button) => {
      if (button.dataset.wtBound === 'true') return;
      button.dataset.wtBound = 'true';

      button.addEventListener('click', async () => {
        const userId = button.dataset.userId;
        const userEmail = button.dataset.userEmail;
        if (!userId) return;

        const original = button.textContent;
        button.disabled = true;
        button.textContent = 'Restableciendo...';

        try {
          const response = await fetch(`/api/admin/users/${userId}/password`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
          });
          const data = await response.json();

          if (!response.ok || !data.success) {
            throw new Error(data.error || 'No se pudo restablecer la clave.');
          }

          const message = document.querySelector<HTMLElement>('[data-reset-message]');
          if (message) {
            message.hidden = false;
            message.dataset.kind = 'ok';
            message.textContent = `Nueva contraseña temporal para ${userEmail}:\n${data.temporaryPassword}\n\nCompártesela al usuario.`;
          }
        } catch (error) {
          const message = document.querySelector<HTMLElement>('[data-reset-message]');
          if (message) {
            message.hidden = false;
            message.dataset.kind = 'error';
            message.textContent = error instanceof Error ? error.message : 'Error inesperado.';
          }
        } finally {
          button.disabled = false;
          button.textContent = original;
        }
      });
    });
  }

  function boot() {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initResetPasswords, { once: true });
    } else {
      initResetPasswords();
    }
    document.addEventListener('astro:page-load', initResetPasswords);
  }

  boot();
</script>
