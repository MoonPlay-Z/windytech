---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { sessionFromRequest } from '../../lib/auth';
import { availabilityLabel } from '../../lib/admin-labels';
import {
  countLeadsByStatus,
  countQuotesByStatus,
  countTrackingsByStatus,
  listPostsAdmin,
  listProductsAdmin,
  listProjectsAdmin,
  listServicePlansAdmin,
} from '../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);

if (!admin) {
  return Astro.redirect('/admin/login/', 302);
}

const [products, projects, posts, quotes, plans, leads, trackings] = await Promise.all([
  listProductsAdmin(),
  listProjectsAdmin(),
  listPostsAdmin(),
  countQuotesByStatus(),
  listServicePlansAdmin(),
  countLeadsByStatus(),
  countTrackingsByStatus(),
]);

const embudo = [
  { label: 'Consultas recibidas', value: leads.new ?? 0, href: '/admin/leads/' },
  {
    label: 'Cotizaciones',
    value: Object.values(quotes).reduce((a, b) => a + b, 0),
    href: '/admin/cotizaciones/',
  },
  { label: 'Cotizaciones nuevas', value: quotes.NEW ?? 0, href: '/admin/cotizaciones/' },
  { label: 'Cerradas (aceptadas)', value: quotes.CLOSED ?? 0, href: '/admin/cotizaciones/' },
  {
    label: 'Seguimientos activos',
    value: Object.entries(trackings)
      .filter(([status]) => status !== 'entregado' && status !== 'cancelado')
      .reduce((a, [, b]) => a + b, 0),
    href: '/admin/seguimientos/',
  },
  { label: 'Equipos entregados', value: trackings.entregado ?? 0, href: '/admin/seguimientos/' },
];
---

<AdminLayout title="Resumen" admin={admin} active="dashboard">
  <section class="admin-welcome">
    <div>
      <p class="admin-welcome-kicker">CENTRO DE OPERACIONES</p>
      <h2>Hola, {admin.email.split('@')[0]}</h2>
      <p>Este es el resumen de actividad de tu tienda.</p>
    </div>
    <a class="admin-btn" href="/admin/productos/nuevo/">+ Añadir producto</a>
  </section>

  <div class="admin-grid">
    <a class="admin-stat admin-stat--products" href="/admin/productos/">
      <span class="admin-stat-icon" aria-hidden="true">▦</span>
      <span class="admin-stat-label">CATÁLOGO</span>
      <strong>{products.length}</strong>
      <span class="admin-stat-caption">Productos registrados</span>
      <span class="admin-stat-link">Ver productos <span aria-hidden="true">→</span></span>
    </a>
    <a class="admin-stat admin-stat--quotes" href="/admin/cotizaciones/">
      <span class="admin-stat-icon" aria-hidden="true">◷</span>
      <span class="admin-stat-label">PENDIENTES</span>
      <strong>{quotes.NEW ?? 0}</strong>
      <span class="admin-stat-caption">Cotizaciones nuevas</span>
      <span class="admin-stat-link">Revisar solicitudes <span aria-hidden="true">→</span></span>
    </a>
    <a class="admin-stat admin-stat--projects" href="/admin/proyectos/">
      <span class="admin-stat-icon" aria-hidden="true">◇</span>
      <span class="admin-stat-label">PORTAFOLIO</span>
      <strong>{projects.length}</strong>
      <span class="admin-stat-caption">Proyectos registrados</span>
      <span class="admin-stat-link">Ver proyectos <span aria-hidden="true">→</span></span>
    </a>
    <a class="admin-stat admin-stat--posts" href="/admin/publicaciones/">
      <span class="admin-stat-icon" aria-hidden="true">▤</span>
      <span class="admin-stat-label">CONTENIDO</span>
      <strong>{posts.length}</strong>
      <span class="admin-stat-caption">Publicaciones</span>
      <span class="admin-stat-link">Gestionar contenido <span aria-hidden="true">→</span></span>
    </a>
    <a class="admin-stat admin-stat--leads" href="/admin/leads/">
      <span class="admin-stat-icon" aria-hidden="true">◎</span>
      <span class="admin-stat-label">CONSULTAS</span>
      <strong>{leads.new ?? 0}</strong>
      <span class="admin-stat-caption">Consultas nuevas</span>
      <span class="admin-stat-link">Ver consultas <span aria-hidden="true">→</span></span>
    </a>
    <a class="admin-stat admin-stat--services" href="/admin/servicios/">
      <span class="admin-stat-icon" aria-hidden="true">◈</span>
      <span class="admin-stat-label">PAQUETES</span>
      <strong>{plans.length}</strong>
      <span class="admin-stat-caption">Paquetes de servicio</span>
      <span class="admin-stat-link">Ver paquetes <span aria-hidden="true">→</span></span>
    </a>
  </div>

  <section class="admin-card">
    <div class="admin-card-heading">
      <div>
        <p class="admin-section-kicker">ATAJOS</p>
        <h2>Accesos rápidos</h2>
      </div>
    </div>
    <div class="admin-quick-links">
      <a href="/admin/productos/nuevo/"><span>＋</span><strong>Añadir producto</strong><small>Incorpora un artículo al catálogo</small></a>
      <a href="/admin/cotizaciones/"><span>↗</span><strong>Ver cotizaciones</strong><small>Responde solicitudes de clientes</small></a>
      <a href="/admin/publicaciones/"><span>✎</span><strong>Crear publicación</strong><small>Actualiza el contenido del sitio</small></a>
    </div>
  </section>

  <section class="admin-card">
    <div class="admin-card-heading">
      <div>
        <p class="admin-section-kicker">EMBUDO</p>
        <h2>De la consulta a la entrega</h2>
      </div>
    </div>
    <div class="admin-funnel">
      {embudo.map((paso) => (
        <a class="admin-funnel-step" href={paso.href}>
          <strong>{paso.value}</strong>
          <span>{paso.label}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="admin-card">
    <div class="admin-card-heading">
      <div>
        <p class="admin-section-kicker">INVENTARIO</p>
        <h2>Estado del catálogo</h2>
      </div>
      <a class="admin-text-link" href="/admin/productos/">Ver todo <span aria-hidden="true">→</span></a>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th scope="col">Producto</th><th scope="col">Precio</th><th scope="col">Disponibilidad</th><th scope="col">Estado</th></tr>
        </thead>
        <tbody>
          {products.slice(0, 8).map((product) => (
            <tr>
              <td><a href={`/admin/productos/${product.id}/`}>{product.name}</a></td>
              <td>${(product.priceCents / 100).toFixed(2)} USD</td>
              <td><span class="admin-badge">{availabilityLabel(product.availability)}</span></td>
              <td>
                <span class:list={['admin-active-state', { 'is-inactive': !product.isActive }]}>
                  <span></span>{product.isActive ? 'Activo' : 'Inactivo'}
                </span>
              </td>
            </tr>
          ))}
          {products.length === 0 && (
            <tr><td colspan="4">Aún no hay productos. <a href="/admin/productos/nuevo/">Crea el primero</a>.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>
