---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { sessionFromRequest } from '../../lib/auth';
import {
  countLeadsByStatus,
  countQuotesByStatus,
  countTrackingsByStatus,
  listPostsAdmin,
  listProductsAdmin,
  listProjectsAdmin,
  listServicePlansAdmin,
} from '../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);

if (!admin) {
  return Astro.redirect('/admin/login/', 302);
}

const [products, projects, posts, quotes, plans, leads, trackings] = await Promise.all([
  listProductsAdmin(),
  listProjectsAdmin(),
  listPostsAdmin(),
  countQuotesByStatus(),
  listServicePlansAdmin(),
  countLeadsByStatus(),
  countTrackingsByStatus(),
]);

/*
 * El embudo se dibuja en SVG: consulta → cotización → cierre → entrega.
 * Se calculan los porcentajes para dibujar las barras proporcionales.
 */
const embudo = [
  { label: 'Consultas recibidas', value: leads.new ?? 0, href: '/admin/leads/', icon: 'leads' },
  {
    label: 'Cotizaciones',
    value: Object.values(quotes).reduce((a, b) => a + b, 0),
    href: '/admin/cotizaciones/',
    icon: 'cotizaciones',
  },
  { label: 'Cotizaciones nuevas', value: quotes.NEW ?? 0, href: '/admin/cotizaciones/', icon: 'cotizaciones' },
  { label: 'Cerradas (aceptadas)', value: quotes.CLOSED ?? 0, href: '/admin/cotizaciones/', icon: 'cotizaciones' },
  {
    label: 'Seguimientos activos',
    value: Object.entries(trackings)
      .filter(([status]) => status !== 'entregado' && status !== 'cancelado')
      .reduce((a, [, b]) => a + b, 0),
    href: '/admin/seguimientos/',
    icon: 'seguimientos',
  },
  { label: 'Equipos entregados', value: trackings.entregado ?? 0, href: '/admin/seguimientos/', icon: 'seguimientos' },
];

// Barras del gráfico: ancho proporcional al máximo.
const maximoEmbudo = Math.max(1, ...embudo.map((paso) => paso.value));
const ancho = (valor: number) => Math.max(3, Math.round((valor / maximoEmbudo) * 100));

/* Avisos: lo que necesita una respuesta del administrador. */
const alertas = [
  {
    icono: 'cotizaciones',
    texto:
      (quotes.NEW ?? 0) > 0
        ? `${quotes.NEW} cotización${(quotes.NEW ?? 0) === 1 ? '' : 'es'} nueva${(quotes.NEW ?? 0) === 1 ? '' : 's'} sin responder`
        : '',
    enlace: '/admin/cotizaciones/',
  },
  {
    icono: 'leads',
    texto:
      (leads.new ?? 0) > 0
        ? `${leads.new} consulta${(leads.new ?? 0) === 1 ? '' : 's'} esperando respuesta`
        : '',
    enlace: '/admin/leads/',
  },
  {
    icono: 'seguimientos',
    texto:
      (trackings.entregado ?? 0) > 0
        ? `${trackings.entregado} seguimiento${(trackings.entregado ?? 0) === 1 ? '' : 's'} entregado${(trackings.entregado ?? 0) === 1 ? '' : 's'}: pide reseña`
        : '',
    enlace: '/admin/seguimientos/',
  },
].filter((alerta) => alerta.texto.length > 0);
---

<AdminLayout title="Resumen" admin={admin} active="dashboard">
  <section class="admin-welcome">
    <div>
      <p class="admin-welcome-kicker">CENTRO DE OPERACIONES</p>
      <h2>Hola, {admin.email.split('@')[0]}</h2>
      <p>Este es el resumen de actividad de tu tienda.</p>
    </div>
    <a class="admin-btn" href="/admin/productos/nuevo/" data-admin-nuevo>+ Añadir producto</a>
  </section>

  {
    alertas.length > 0 && (
      <section class="admin-card admin-alerts">
        <header class="admin-card-heading">
          <div>
            <p class="admin-section-kicker">PENDIENTE</p>
            <h2>Lo que necesita tu atención</h2>
          </div>
        </header>
        <ul class="admin-alert-list">
          {alertas.map((alerta) => (
            <li>
              <a href={alerta.enlace}>
                <span class="admin-alert-icon">
                  <Icon name={alerta.icono as any} size={16} />
                </span>
                <span>{alerta.texto}</span>
                <Icon name="arrow-right" size={15} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="win-tiles">
    <a class="win-tile win-tile--blue" href="/admin/productos/nuevo/">
      <span class="win-tile-icon"><Icon name="plus" size={22} /></span>
      <span class="win-tile-body">
        <strong>Producto nuevo</strong>
        <span>Añade un equipo al catálogo</span>
      </span>
    </a>
    <a class="win-tile win-tile--green" href="/admin/cotizaciones/">
      <span class="win-tile-icon"><Icon name="cotizaciones" size={22} /></span>
      <span class="win-tile-body">
        <strong>Cotizaciones</strong>
        <span>{quotes.NEW ?? 0} esperando respuesta</span>
      </span>
    </a>
    <a class="win-tile win-tile--teal" href="/admin/leads/">
      <span class="win-tile-icon"><Icon name="leads" size={22} /></span>
      <span class="win-tile-body">
        <strong>Consultas</strong>
        <span>{leads.new ?? 0} nuevas este mes</span>
      </span>
    </a>
    <a class="win-tile win-tile--orange" href="/admin/seguimientos/">
      <span class="win-tile-icon"><Icon name="seguimientos" size={22} /></span>
      <span class="win-tile-body">
        <strong>Seguimientos</strong>
        <span>Servicios y equipos</span>
      </span>
    </a>
    <a class="win-tile win-tile--purple" href="/admin/publicaciones/nueva/">
      <span class="win-tile-icon"><Icon name="publicaciones" size={22} /></span>
      <span class="win-tile-body">
        <strong>Publicación</strong>
        <span>Escribe en el blog</span>
      </span>
    </a>
    <a class="win-tile win-tile--navy" href="/admin/productos/">
      <span class="win-tile-icon"><Icon name="productos" size={22} /></span>
      <span class="win-tile-body">
        <strong>Catálogo</strong>
        <span>{products.length} productos cargados</span>
      </span>
    </a>
  </div>

  <div class="admin-grid">
    <a class="admin-stat admin-stat--quotes" href="/admin/cotizaciones/">
      <span class="admin-stat-icon" aria-hidden="true"><Icon name="cotizaciones" size={20} /></span>
      <span class="admin-stat-label">PENDIENTES</span>
      <strong>{quotes.NEW ?? 0}</strong>
      <span class="admin-stat-caption">Cotizaciones nuevas</span>
      <span class="admin-stat-link">Revisar solicitudes <span aria-hidden="true">→</span></span>
    </a>
    <a class="admin-stat admin-stat--leads" href="/admin/leads/">
      <span class="admin-stat-icon" aria-hidden="true"><Icon name="leads" size={20} /></span>
      <span class="admin-stat-label">CONSULTAS</span>
      <strong>{leads.new ?? 0}</strong>
      <span class="admin-stat-caption">Consultas nuevas</span>
      <span class="admin-stat-link">Ver consultas <span aria-hidden="true">→</span></span>
    </a>
    <a class="admin-stat admin-stat--products" href="/admin/productos/">
      <span class="admin-stat-icon" aria-hidden="true"><Icon name="productos" size={20} /></span>
      <span class="admin-stat-label">CATÁLOGO</span>
      <strong>{products.length}</strong>
      <span class="admin-stat-caption">Productos registrados</span>
      <span class="admin-stat-link">Ver productos <span aria-hidden="true">→</span></span>
    </a>
    <a class="admin-stat admin-stat--services" href="/admin/servicios/">
      <span class="admin-stat-icon" aria-hidden="true"><Icon name="paquetes" size={20} /></span>
      <span class="admin-stat-label">PAQUETES</span>
      <strong>{plans.length}</strong>
      <span class="admin-stat-caption">Paquetes de servicio</span>
      <span class="admin-stat-link">Ver paquetes <span aria-hidden="true">→</span></span>
    </a>
  </div>

  <section class="admin-card">
    <div class="admin-card-heading">
      <div>
        <p class="admin-section-kicker">EMBUDO</p>
        <h2>De la consulta a la entrega</h2>
      </div>
    </div>
    <div class="admin-funnel-chart">
      {
        embudo.map((paso) => (
          <a class="admin-funnel-row" href={paso.href}>
            <span class="admin-funnel-label">{paso.label}</span>
            <span class="admin-funnel-track">
              <span class="admin-funnel-bar" style={`width:${ancho(paso.value)}%`} />
            </span>
            <strong class="admin-funnel-value">{paso.value}</strong>
          </a>
        ))
      }
    </div>
  </section>

  <section class="admin-card">
    <div class="admin-card-heading">
      <div>
        <p class="admin-section-kicker">INVENTARIO</p>
        <h2>Estado del catálogo</h2>
      </div>
      <a class="admin-text-link" href="/admin/productos/">Ver todo <span aria-hidden="true">→</span></a>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th>Producto</th><th>Precio</th><th>Disponibilidad</th><th>Estado</th></tr>
        </thead>
        <tbody>
          {products.slice(0, 8).map((product) => (
            <tr>
              <td><a href={`/admin/productos/${product.id}/`}>{product.name}</a></td>
              <td class="win-num">${(product.priceCents / 100).toFixed(2)}</td>
              <td><span class="admin-badge">{product.availability.replaceAll('_', ' ')}</span></td>
              <td>
                <span class:list={['admin-active-state', { 'is-inactive': !product.isActive }]}>
                  <span></span>{product.isActive ? 'Activo' : 'Inactivo'}
                </span>
              </td>
            </tr>
          ))}
          {products.length === 0 && (
            <tr><td colspan="4">Aún no hay productos. <a href="/admin/productos/nuevo/">Crea el primero</a>.</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </section>

  <section class="admin-card">
    <div class="admin-card-heading">
      <div>
        <p class="admin-section-kicker">CONTENIDO</p>
        <h2>Proyectos y publicaciones</h2>
      </div>
    </div>
    <div class="admin-grid admin-grid--compact">
      <a class="admin-stat" href="/admin/proyectos/">
        <span class="admin-stat-icon" aria-hidden="true"><Icon name="proyectos" size={20} /></span>
        <span class="admin-stat-label">PORTAFOLIO</span>
        <strong>{projects.length}</strong>
        <span class="admin-stat-caption">Proyectos publicados</span>
      </a>
      <a class="admin-stat" href="/admin/publicaciones/">
        <span class="admin-stat-icon" aria-hidden="true"><Icon name="publicaciones" size={20} /></span>
        <span class="admin-stat-label">CONTENIDO</span>
        <strong>{posts.length}</strong>
        <span class="admin-stat-caption">Publicaciones</span>
      </a>
    </div>
  </section>
</AdminLayout>
