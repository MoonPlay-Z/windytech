---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import AdminTable from '../../../components/admin/AdminTable.astro';
import { sessionFromRequest } from '../../../lib/auth';
import { listProjectsAdmin } from '../../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);

const projects = await listProjectsAdmin();
---

<AdminLayout title="Proyectos" admin={admin} active="projects"
  crumbs={[{ label: 'Contenido', icon: 'proyectos' }, { label: 'Proyectos' }]}
>
  <section class="admin-card">
    <header class="admin-actions">
      <a class="admin-btn" href="nuevo/">Nuevo proyecto</a>
    </header>
    <AdminTable
      empty="Sin registros."
      columns={[
    { key: 'numero', label: 'Número' },
    { key: 'titulo', label: 'Título' },
    { key: 'anio', label: 'Año' },
    { key: 'cliente', label: 'Cliente' },
    { key: 'publicado', label: 'Publicado' },
    { key: 'aprobado', label: 'Aprobado' },
      ]}
    >
      <table class="admin-table win-table-grid">
      <thead>
        <tr><th data-column="numero" style="width:40px">#</th><th data-column="titulo">Título</th><th data-column="anio">Año</th><th data-column="cliente">Cliente</th><th data-column="publicado">Publicado</th><th data-column="aprobado">Aprobado</th></tr>
      </thead>
      <tbody>
        {projects.map((project) => (
          <tr>
            <td>{project.id}</td>
            <td>{project.title}</td>
            <td>{project.year ?? '—'}</td>
            <td>{project.clientName}</td>
            <td>{project.isPublished ? 'Sí' : 'No'}</td>
            <td>{project.clientApproved ? 'Sí' : 'No'}</td>
          </tr>
        ))}
        {projects.length === 0 && <tr><td colspan="6">Sin proyectos.</td></tr>}
      </tbody>
      </table>
    </AdminTable>
  </section>
  <script>
    import '../../../scripts/admin-table';
  </script>
</AdminLayout>
