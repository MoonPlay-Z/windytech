---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { sessionFromRequest } from '../../../lib/auth';
import { listProjectsAdmin } from '../../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);

const projects = await listProjectsAdmin();
---

<AdminLayout title="Proyectos" admin={admin} active="projects">
  <section class="admin-card">
    <header class="admin-actions">
      <a class="admin-btn" href="nuevo/">Nuevo proyecto</a>
    </header>
    <table class="admin-table">
      <thead>
        <tr><th style="width:40px" scope="col">#</th><th scope="col">Título</th><th scope="col">Año</th><th scope="col">Cliente</th><th scope="col">Publicado</th><th scope="col">Aprobado</th><th scope="col">Acciones</th></tr>
      </thead>
      <tbody>
        {projects.map((project) => (
          <tr>
            <td>{project.id}</td>
            <td>{project.title}</td>
            <td>{project.year ?? '—'}</td>
            <td>{project.clientName}</td>
            <td>{project.isPublished ? 'Sí' : 'No'}</td>
            <td>{project.clientApproved ? 'Sí' : 'No'}</td>
            <td>
              <div class="admin-actions-cell">
                <a class="admin-btn admin-btn--ghost admin-btn--sm" href={`/admin/proyectos/${project.id}/`}>Editar</a>
                <button
                  class="admin-btn admin-btn--danger admin-btn--sm"
                  data-delete={`/api/admin/projects?id=${project.id}`}
                  data-confirm="¿Eliminar este proyecto?"
                >
                  Eliminar
                </button>
              </div>
            </td>
          </tr>
        ))}
        {projects.length === 0 && <tr><td colspan="7">Sin proyectos.</td></tr>}
      </tbody>
    </table>
  </section>
</AdminLayout>
