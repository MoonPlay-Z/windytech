---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { sessionFromRequest } from '../../../lib/auth';
import { promotionTypeLabel, promotionValueLabel } from '../../../lib/admin-labels';
import { listPromotionsAdmin } from '../../../lib/db/queries';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (!admin) return Astro.redirect('/admin/login/', 302);

const promotions = await listPromotionsAdmin();

const fechaPromocion = (value: string | null) =>
  value
    ? new Intl.DateTimeFormat('es-VE', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(value))
    : '—';
---

<AdminLayout title="Promociones" admin={admin} active="promotions">
  <section class="admin-card">
    <header class="admin-actions">
      <a class="admin-btn" href="nueva/">Nueva promoción</a>
    </header>
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width:40px" scope="col">#</th>
          <th scope="col">Nombre</th>
          <th scope="col">Tipo</th>
          <th scope="col">Valor</th>
          <th scope="col">Prioridad</th>
          <th scope="col">Vigencia</th>
          <th scope="col">Activa</th>
          <th scope="col">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {promotions.map((promotion) => (
          <tr>
            <td>{promotion.id}</td>
            <td>{promotion.name}</td>
            <td>{promotionTypeLabel(promotion.type)}</td>
            <td>{promotionValueLabel(promotion.type, promotion.value)}</td>
            <td>{promotion.priority}</td>
            <td>
              {fechaPromocion(promotion.startsAt)}
              {promotion.endsAt ? ` → ${fechaPromocion(promotion.endsAt)}` : ''}
            </td>
            <td>{promotion.isActive ? 'Sí' : 'No'}</td>
            <td>
              <a class="admin-btn admin-btn--ghost admin-btn--sm" href={`/admin/promociones/${promotion.id}/`}>Editar</a>
              <button
                class="admin-btn admin-btn--danger admin-btn--sm"
                data-delete={`/api/admin/promotions?id=${promotion.id}`}
                data-confirm="¿Eliminar esta promoción?"
              >
                Eliminar
              </button>
            </td>
          </tr>
        ))}
        {promotions.length === 0 && <tr><td colspan="8">Sin promociones.</td></tr>}
      </tbody>
    </table>
  </section>
</AdminLayout>
