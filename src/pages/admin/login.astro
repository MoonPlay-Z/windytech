---
import '../../styles/global.css';
import '../../styles/admin.css';
import '../../styles/admin-desktop.css';
import '../../styles/responsive/index.css';
import { sessionFromRequest } from '../../lib/auth';

export const prerender = false;

const admin = await sessionFromRequest(Astro.request);
if (admin) return Astro.redirect('/admin/', 302);
---

<!doctype html>
<html lang="es" class="admin-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Acceso al panel | Windytech</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
  </head>
  <body class="admin-body admin-body--login">
    <main class="admin-login">
      <div class="admin-login-window">
        <header class="win-dialog-titlebar admin-login-titlebar">
          <span class="win-dialog-title">Panel Windytech — Acceso</span>
          <span class="admin-login-window-buttons" aria-hidden="true">
            <span class="admin-login-btn"><span aria-hidden="true">─</span></span>
            <span class="admin-login-btn"><span aria-hidden="true">☐</span></span>
          </span>
        </header>

        <form class="admin-login-card admin-form" data-login-form>
          <div class="admin-login-brand">
            <img src="/assets/logo-mark-96.webp" alt="" width="52" height="52" />
            <div>
              <strong>Windytech</strong>
              <span>Panel de administración</span>
            </div>
          </div>

          <p class="admin-hint">
            Acceso para el equipo autorizado. Las sesiones duran 8 horas.
          </p>

          <label>
            <span>Correo</span>
            <input
              type="email"
              name="email"
              autocomplete="username"
              placeholder="tu@windytech.studio"
              required
            />
          </label>
          <label>
            <span>Contraseña</span>
            <input
              type="password"
              name="password"
              autocomplete="current-password"
              minlength="8"
              required
            />
          </label>

          <p class="admin-message" data-form-message hidden></p>

          <button class="admin-btn admin-btn--primary" type="submit">Entrar</button>

          <p class="admin-hint">
            ¿Olvidaste la contraseña? Pide al propietario que la restablezca.
          </p>
        </form>
      </div>
    </main>
    <script>
      import '../../scripts/admin';
    </script>
  </body>
</html>
