---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/account.css';
import { customerSessionFromRequest } from '../../lib/customer-auth';

export const prerender = false;

if (await customerSessionFromRequest(Astro.request)) {
  return Astro.redirect('/cuenta/perfil/', 302);
}
---

<BaseLayout
  lang="es"
  title="Iniciar sesión | Windytech"
  description="Accede a tu cuenta de Windytech."
  path="/cuenta/login/"
  altPath="/cuenta/login/"
  noindex={true}
  hideWhatsappFloat={true}
>
  <section class="section section--soft account-section">
    <div class="container account-layout">
      <aside class="account-intro">
        <img
          class="account-logo"
          src="/assets/logo-mark-large-112.webp?v=2"
          alt=""
          width="56"
          height="57"
        />
        <p class="eyebrow">Tu espacio Windytech</p>
        <h1>Qué bueno <span>verte de nuevo.</span></h1>
        <p class="account-intro-copy">
          Inicia sesión para continuar con tu experiencia y mantener todo a mano.
        </p>
        <a class="account-home-link" href="/">← Volver al sitio</a>
      </aside>

      <div class="account-card">
        <div class="account-card-heading">
          <p class="eyebrow">Bienvenido de vuelta</p>
          <h2>Iniciar sesión</h2>
          <p>Ingresa tus datos para acceder a tu cuenta.</p>
        </div>
        <form class="account-form" data-auth-form action="/api/auth/login">
          <div class="account-field">
            <label for="login-email">Correo electrónico</label>
            <input
              id="login-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="200"
              placeholder="tu@correo.com"
            />
          </div>
          <div class="account-field">
            <label for="login-password">Contraseña</label>
            <input
              id="login-password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              minlength="8"
              maxlength="72"
              placeholder="Tu contraseña"
            />
          </div>
          <p class="account-message" data-auth-message role="alert" hidden></p>
          <button class="btn btn-primary account-submit" type="submit">Entrar a mi cuenta</button>
        </form>
        <p class="account-switch">
          ¿Aún no tienes cuenta? <a href="/cuenta/registro/">Regístrate</a>
        </p>
      </div>
    </div>
  </section>

    <script>
      import '../../scripts/customer-auth';
    </script>
</BaseLayout>
