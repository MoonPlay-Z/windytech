---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import '../../../styles/account.css';
import { customerSessionFromRequest } from '../../../lib/customer-auth';
import { getTrackingForCustomer, listTrackingEvents } from '../../../lib/db/queries';
import { trackingMeta, trackingStatus } from '../../../lib/trackings';

export const prerender = false;

const customer = await customerSessionFromRequest(Astro.request);
if (!customer) return Astro.redirect('/cuenta/login/', 302);

const id = Number(Astro.params.id ?? '');
if (!Number.isInteger(id) || id <= 0) return Astro.redirect('/cuenta/seguimientos/', 302);

const tracking = await getTrackingForCustomer(id, customer.id);
if (!tracking) return Astro.redirect('/cuenta/seguimientos/', 302);

const events = await listTrackingEvents(tracking.id);
const meta = trackingMeta(tracking.kind);
const estado = trackingStatus(tracking.kind, tracking.status);

const fecha = (value: string | null) =>
  value
    ? new Intl.DateTimeFormat('es-VE', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      }).format(new Date(value))
    : null;
---

<BaseLayout
  title={`${tracking.title} | Seguimiento | Windytech`}
  description="Detalle y historial del seguimiento."
  path={`/cuenta/seguimientos/${tracking.id}/`}
  noindex={true}
  hideWhatsappFloat={true}
>
  <section class="section section--soft account-section">
    <div class="container account-layout account-layout--wide">
      <aside class="account-intro">
        <img
          class="account-logo"
          src="/assets/logo-mark-large-112.webp?v=2"
          alt=""
          width="56"
          height="57"
        />
        <p class="eyebrow">{meta.label}</p>
        <p class="account-intro-copy">{meta.description}</p>
        <nav class="account-links" aria-label="Secciones de tu cuenta">
          <a href="/cuenta/seguimientos/">← Todos mis seguimientos</a>
          <a href="/cuenta/perfil/">Mis datos</a>
        </nav>
      </aside>

      <div class="tracking-panel">
        <header class="account-card-heading">
          <p class="eyebrow">Estado actual</p>
          <h1 class="tracking-title">{tracking.title}</h1>
          <p class="tracking-ref">
            {tracking.reference ? `Referencia: ${tracking.reference}` : 'Sin referencia'}
          </p>
          <p>
            <span class={`tracking-badge is-${estado?.tone ?? 'neutral'}`}>
              {estado?.label ?? tracking.status}
            </span>
          </p>
        </header>

        <div class="tracking-progress tracking-progress--lg" role="img" aria-label={`Avance ${tracking.progress}%`}>
          <span style={`width:${tracking.progress}%`} />
        </div>
        <p class="tracking-meta">
          <span>Avance {tracking.progress}%</span>
          {tracking.eta && <span>Entrega estimada: {fecha(tracking.eta)}</span>}
          <span>Alta: {fecha(tracking.createdAt)}</span>
          <span>Última actualización: {fecha(tracking.updatedAt)}</span>
        </p>

        {tracking.summary && <p class="tracking-summary">{tracking.summary}</p>}

        <section class="tracking-timeline" aria-labelledby="historial">
          <h3 id="historial">Historial</h3>
          <ol>
            {
              events.map((event) => {
                const estadoEvento = trackingStatus(tracking.kind, event.status);
                return (
                  <li>
                    <span class={`tracking-dot is-${estadoEvento?.tone ?? 'neutral'}`} />
                    <div>
                      <strong>{estadoEvento?.label ?? event.status}</strong>
                      {event.note && <p>{event.note}</p>}
                      <small>
                        {fecha(event.createdAt)} · {event.author}
                      </small>
                    </div>
                  </li>
                );
              })
            }
          </ol>
        </section>

        <div class="tracking-actions">
          <a
            class="btn btn-primary"
            href={`https://wa.me/584127723148?text=${encodeURIComponent(
              `Hola Windytech, quiero consultar el seguimiento «${tracking.title}»${tracking.reference ? ` (${tracking.reference})` : ''}.`,
            )}`}
            target="_blank"
            rel="noopener noreferrer"
            data-track="whatsapp"
          >
            <Icon name="whatsapp" size={18} />
            Consultar por WhatsApp
          </a>
          <a class="btn btn-light" href="/cuenta/seguimientos/">Ver todos</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
