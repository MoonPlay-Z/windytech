---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CurrencySwitch from '../../components/catalog/CurrencySwitch.astro';
import { catalogCopy, type Locale } from '../../lib/catalog';
import { currentRate } from '../../lib/rate';
import { isVenezuela } from '../../lib/security';
import { site, whatsappLink } from '../../data/site';

export const prerender = false;

const locale: Locale = 'es';
const t = catalogCopy[locale];
const rate = await currentRate();
const currencyDefault = isVenezuela(Astro.request) ? 'VES' : 'USD';
---

<BaseLayout
  lang="es"
  title="Carrito y cotización | Windytech"
  description="Revisa tu carrito y solicita una cotización por WhatsApp. Precios sin IVA."
  path="/carrito/"
  altPath="/en/cart/"
  noindex
  currencyDefault={currencyDefault}
  hideWhatsappFloat
>
  <section class="section section--soft cart-section">
    <div class="container">
      <div class="cart-head">
        <div>
          <span class="eyebrow">{t.eyebrow}</span>
          <h1>{t.cartTitle}</h1>
          <p>{t.noTax}</p>
        </div>
        <CurrencySwitch locale={locale} rate={rate} />
      </div>

      <div
        data-cart-root
        data-locale="es"
        data-rate={rate?.rate ?? 0}
        data-currency-default={currencyDefault}
      >
        <div class="cart-empty" data-cart-empty hidden>
          <Icon name="shopping-cart" size={44} />
          <p>{t.cartEmpty}</p>
          <a class="btn btn-primary" href="/catalogo/">{t.cartEmptyCta}</a>
        </div>

        <div class="cart-layout" data-cart-table>
          <div class="cart-panel">
            <h2>{t.quoteItems}</h2>
            <div class="cart-lines" data-cart-items></div>

            <div class="cart-totals">
              <div>
                <span>{t.subtotal}</span>
                <strong data-cart-subtotal>—</strong>
              </div>
              <div>
                <span>{t.discount}</span>
                <strong>—</strong>
              </div>
              <div class="cart-total-row">
                <span>{t.total}</span>
                <strong data-cart-total>—</strong>
              </div>
              <p class="cart-note">{t.noTax}</p>
            </div>
          </div>

          <aside class="cart-panel cart-form-panel">
            <h2>{t.formTitle}</h2>
            <form class="cart-form" data-quote-form novalidate>
              <label>
                <span>{t.name}</span>
                <input name="customerName" required minlength="2" maxlength="120" autocomplete="name" />
              </label>
              <label>
                <span>{t.phone}</span>
                <input name="phone" required minlength="6" maxlength="40" inputmode="tel" autocomplete="tel" />
              </label>
              <label>
                <span>{t.email}</span>
                <input name="email" type="email" maxlength="200" autocomplete="email" />
              </label>
              <label>
                <span>{t.notes}</span>
                <textarea name="notes" rows="3" maxlength="1500" placeholder={t.notesPlaceholder}></textarea>
              </label>
              <label class="cart-honeypot" aria-hidden="true">
                <span>No rellenar</span>
                <input name="website" tabindex="-1" autocomplete="off" />
              </label>
              <p class="cart-note">
                <a href="/legal/privacidad/" target="_blank" rel="noopener">Política de privacidad</a>
              </p>
              <p class="form-error" data-form-error hidden></p>
              <button class="btn btn-primary" type="submit">{t.submit}</button>
              <span class="cart-status" data-form-status aria-live="polite"></span>
            </form>

            <div class="cart-success" data-quote-success hidden>
              <Icon name="check" size={32} />
              <h3>{t.success}</h3>
              <p class="cart-success-number" data-quote-number></p>
              <p>{t.successText}</p>
              <a class="cart-success-link" data-quote-link href="#"></a>
              <div class="cart-success-actions">
                <a class="btn btn-primary" data-quote-whatsapp href="#" target="_blank" rel="noopener noreferrer">
                  <Icon name="whatsapp" size={18} />
                  {t.sendWhatsapp}
                </a>
                <a class="btn btn-light" href="/catalogo/">{t.continue}</a>
              </div>
            </div>
          </aside>
        </div>
      </div>

      <p class="cart-help">
        ¿Necesitas ayuda? <a href={whatsappLink('Hola Windytech, necesito ayuda con mi cotización.')} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>.
      </p>
    </div>
  </section>
</BaseLayout>
