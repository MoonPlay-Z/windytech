---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { site, whatsappLink } from '../../data/site';
import { services } from '../../data/services';
import { CITIES, cityBySlug } from '../../data/ciudades';
import { getCatalog } from '../../lib/db/queries';

export const prerender = false;

const slug = (Astro.params.ciudad ?? '').toLowerCase();
const city = cityBySlug(slug);

// Solo se indexan las ciudades con ficha real; el resto va al 404.
if (!city) {
  return Astro.redirect('/404/', 302);
}

const products = await getCatalog({ limit: 3 });

const title = `${city.name} | Software, automatización y equipos | Windytech`;
// Hasta 160 caracteres: es lo que Google muestra completo en los resultados.
const description = `${city.claim}. Trabajamos en ${city.name} y municipios cercanos. ${city.delivery}.`;
const path = `/${city.slug}/`;
const canonical = new URL(path, site.url).toString();

const schema = {
  '@type': 'ProfessionalService',
  '@id': `${canonical}#servicio`,
  name: `Windytech ${city.name}`,
  description,
  url: canonical,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: [
    { '@type': 'City', name: city.name },
    ...city.zones.map((zone) => ({ '@type': 'Place', name: zone })),
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: city.name,
    addressRegion: city.state,
    addressCountry: 'VE',
  },
  telephone: `+${site.whatsappNumber}`,
  availableLanguage: ['Spanish'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Servicios en ${city.name}`,
    itemListElement: services.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Service',
        name: service.content.title,
        description: service.content.cardText,
        url: new URL(service.path, site.url).toString(),
      },
    })),
  },
};

---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogImage="/assets/og.png"
  ogImageAlt={`Servicios de Windytech en ${city.name}`}
  pageType="CollectionPage"
  extraSchema={[schema]}
  breadcrumb={[
    { name: 'Inicio', path: '/' },
    { name: city.name, path },
  ]}
>
  <section class="city-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span>{city.name}</span>
      </nav>
      <span class="eyebrow">{city.name} · {city.state}</span>
      <h1>{city.claim}</h1>
      <p>
        Atendemos negocios de {city.name} y municipios cercanos con software a medida,
        automatización de WhatsApp, páginas web, marketing y equipos. Visitamos
        {' '}{city.zones.slice(0, 3).join(', ')} y el resto del trabajo lo hacemos en
        remoto, con el mismo alcance y los mismos entregables.
      </p>
      <div class="city-hero-actions">
        <a
          class="btn btn-primary"
          href={whatsappLink(`Hola Windytech, necesito servicios en ${city.name}.`)}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp"
        >
          Cotizar en {city.name}
          <Icon name="whatsapp" size={18} />
        </a>
        <a class="btn btn-light" href="/servicios/">Ver los servicios</a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container city-facts">
      <div class="city-fact">
        <span class="eyebrow">Zonas</span>
        <h2>Dónde trabajamos</h2>
        <ul class="city-zones">
          {city.zones.map((zone) => (
            <li>
              <Icon name="check-simple" size={16} />
              <span>{zone}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="city-fact">
        <span class="eyebrow">Plazos</span>
        <h2>Entrega en {city.name}</h2>
        <p>{city.delivery}.</p>
        <p>{city.note}</p>
        <p class="city-contact">
          WhatsApp <a href={whatsappLink(`Hola Windytech, estoy en ${city.name}.`)} target="_blank" rel="noopener noreferrer">{site.whatsappDisplay}</a>
          {' · '}
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <h2>Servicios disponibles en {city.name}</h2>
        <p>Elige el que necesitas. También los combinamos en un mismo proyecto.</p>
      </div>
      <div class="service-grid">
        {services.map((service) => (
          <article class="card">
            <span class={`icon-badge icon-badge--${service.content.icon}`}>
              <Icon name={service.content.icon} size={26} />
            </span>
            <h3>
              <a href={service.path}>{service.content.title}</a>
            </h3>
            <p>{service.content.cardText}</p>
            <a class="text-link" href={service.path}>
              Ver servicio
              <Icon name="arrow-right" size={16} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {
    products.length > 0 && (
      <section class="section section--white">
        <div class="container">
          <div class="section-head">
            <h2>Equipos disponibles con entrega en {city.name}</h2>
            <p>Stock limitado: confírmalo antes de pagar.</p>
          </div>
          <div class="product-grid">
            {products.map((product) => (
              <article class="product-card">
                <a class="product-card-media" href={`/catalogo/${product.slug}/`}>
                  <span class="product-card-placeholder" aria-hidden="true">
                    <Icon name="monitor" size={40} />
                  </span>
                  <span class="product-availability">
                    {product.availability === 'IN_STOCK'
                      ? 'Disponible'
                      : product.availability === 'PREORDER'
                        ? 'Preventa'
                        : 'Agotado'}
                  </span>
                </a>
                <div class="product-card-body">
                  <div class="product-meta">
                    <span>{product.brand}</span>
                  </div>
                  <h3>
                    <a href={`/catalogo/${product.slug}/`}>{product.name}</a>
                  </h3>
                  <p class="product-price">
                    <span class="product-price-now">${(product.priceCents / 100).toFixed(2)}</span>
                  </p>
                </div>
              </article>
            ))}
          </div>
          <p class="city-more">
            <a class="btn btn-light" href="/catalogo/">Ver el catálogo completo</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section section--white">
    <div class="container city-others">
      <h2>Otras ciudades donde trabajamos</h2>
      <div class="city-others-list">
        {CITIES.filter((item) => item.slug !== city.slug).map((item) => (
          <a href={`/${item.slug}/`}>
            {item.name}
            <Icon name="arrow-right" size={15} />
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
