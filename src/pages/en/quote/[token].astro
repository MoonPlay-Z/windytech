---
import QuoteView from '../../../components/catalog/QuoteView.astro';
import { getQuoteByToken } from '../../../lib/db/queries';

export const prerender = false;

const token = Astro.params.token ?? '';
const quote = await getQuoteByToken(token);
if (!quote) return Astro.redirect('/en/cart/', 302);
---

<QuoteView quote={quote} locale="en" />
