---
import ServicePage from '../../../components/ServicePage.astro';
import { services } from '../../../data/services';

// El sitio se renderiza bajo demanda (output: 'server'), así que la página
// busca el servicio por su slug en lugar de recibirlo en Astro.props.
export const prerender = false;

const slug = Astro.params.slug ?? '';
const service = services.find((item) => item.en.slug === slug);
if (!service) return Astro.redirect('/404/', 302);
---

<ServicePage
  lang="en"
  service={service}
  path={service.pathEn}
  altPath={service.pathEs}
/>
