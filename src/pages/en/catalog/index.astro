---
import '../../../styles/catalog.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import ProductCard from '../../../components/catalog/ProductCard.astro';
import CatalogFilters from '../../../components/catalog/CatalogFilters.astro';
import CurrencySwitch from '../../../components/catalog/CurrencySwitch.astro';
import ShareBar from '../../../components/ShareBar.astro';
import { catalogCopy, type Locale } from '../../../lib/catalog';
import { getBrands, getCatalog, getCategories } from '../../../lib/db/queries';
import { currentRate } from '../../../lib/rate';
import { isVenezuela } from '../../../lib/security';
import { site, whatsappLink } from '../../../data/site';

export const prerender = false;

const locale: Locale = 'en';
const t = catalogCopy[locale];
const params = Astro.url.searchParams;

const [rate, categories, brands, products] = await Promise.all([
  currentRate(),
  getCategories(locale),
  getBrands(),
  getCatalog({
    locale,
    category: params.get('category') ?? undefined,
    condition: params.get('condition') ?? undefined,
    brand: params.get('brand') ?? undefined,
    search: params.get('q') ?? undefined,
    minCents: params.get('min') ? Number(params.get('min')) * 100 : undefined,
    maxCents: params.get('max') ? Number(params.get('max')) * 100 : undefined,
  }),
]);

const currencyDefault = isVenezuela(Astro.request) ? 'VES' : 'USD';

const itemListSchema = {
  '@type': 'ItemList',
  '@id': `${site.url}/en/catalog/#items`,
  name: t.title,
  numberOfItems: products.length,
  itemListElement: products.slice(0, 30).map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/en/catalog/${product.slug}/`, site.url).toString(),
    name: product.name,
  })),
};
---

<BaseLayout
  lang="en"
  title="IT equipment catalog | Windytech"
  description="Laptops, desktops, monitors and accessories with USD pricing, current availability and a WhatsApp quote. Prices exclude VAT."
  path="/en/catalog/"
  altPath="/catalogo/"
  ogImage="/assets/og-en.png"
  ogImageAlt="Windytech IT equipment catalog"
  currencyDefault={currencyDefault}
  extraSchema={[itemListSchema]}
  breadcrumb={[
    { name: 'Home', path: '/en/' },
    { name: 'Catalog', path: '/en/catalog/' },
  ]}
>
  <section class="catalog-hero">
    <div class="container">
      <span class="eyebrow">{t.eyebrow}</span>
      <h1>{t.title}</h1>
      <p class="catalog-intro">{t.intro}</p>
      <div class="catalog-hero-meta">
        <span>{t.noTaxNote}</span>
        <CurrencySwitch locale={locale} rate={rate} />
      </div>
    </div>
  </section>

  <section class="section section--white catalog-section">
    <div class="container">
      <CatalogFilters
        locale={locale}
        categories={categories}
        brands={brands}
        action="/en/catalog/"
        values={{
          q: params.get('q') ?? '',
          category: params.get('category') ?? '',
          condition: params.get('condition') ?? '',
          brand: params.get('brand') ?? '',
          min: params.get('min') ?? '',
          max: params.get('max') ?? '',
        }}
      />

      <div class="catalog-count">
        <strong>{products.length}</strong> {t.results}
      </div>

      <ShareBar
        path="/en/catalog/"
        title={`${t.title} | ${site.name}`}
        text={t.intro}
        lang="en"
        label="Share the catalog with your customers"
        campaign="catalog"
        variant="card"
      />

      {products.length === 0 ? (
        <div class="catalog-empty">
          <Icon name="monitor" size={40} />
          <p>{t.emptyDb}</p>
          <a
            class="btn btn-primary"
            href={whatsappLink('Hello Windytech, I would like to check equipment availability.')}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.askAvailability}
          </a>
        </div>
      ) : (
        <div class="product-grid">
          {products.map((product) => (
            <ProductCard product={product} locale="en" rate={rate} />
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  import '../../../scripts/cart';
</script>
