---
import ProductDetail from '../../../components/catalog/ProductDetail.astro';
import { getProduct, getProductSlug } from '../../../lib/db/queries';
import { currentRate } from '../../../lib/rate';
import { isVenezuela } from '../../../lib/security';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const product = await getProduct('en', slug);
if (!product) return Astro.redirect('/en/catalog/', 302);

const [rate, altSlug] = await Promise.all([
  currentRate(),
  getProductSlug(product.id, 'es'),
]);

const currencyDefault = isVenezuela(Astro.request) ? 'VES' : 'USD';
---

<ProductDetail
  product={product}
  locale="en"
  rate={rate}
  currencyDefault={currencyDefault}
  altSlug={altSlug ?? undefined}
/>
