---
import '../../styles/catalog.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/catalog/ProductCard.astro';
import CatalogFilters from '../../components/catalog/CatalogFilters.astro';
import CurrencySwitch from '../../components/catalog/CurrencySwitch.astro';
import ShareBar from '../../components/ShareBar.astro';
import { catalogCopy, type Locale } from '../../lib/catalog';
import { getBrands, getCatalog, getCategories } from '../../lib/db/queries';
import { currentRate } from '../../lib/rate';
import { isVenezuela } from '../../lib/security';
import { site, whatsappLink } from '../../data/site';

export const prerender = false;

const t = catalogCopy;
const params = Astro.url.searchParams;

const [rate, categories, brands, products] = await Promise.all([
  currentRate(),
  getCategories(),
  getBrands(),
  getCatalog({
        category: params.get('category') ?? undefined,
    condition: params.get('condition') ?? undefined,
    brand: params.get('brand') ?? undefined,
    search: params.get('q') ?? undefined,
    minCents: params.get('min') ? Number(params.get('min')) * 100 : undefined,
    maxCents: params.get('max') ? Number(params.get('max')) * 100 : undefined,
  }),
]);

const currencyDefault = isVenezuela(Astro.request) ? 'VES' : 'USD';

const itemListSchema = {
  '@type': 'ItemList',
  '@id': `${site.url}/catalogo/#items`,
  name: t.title,
  numberOfItems: products.length,
  itemListElement: products.slice(0, 30).map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/catalogo/${product.slug}/`, site.url).toString(),
    name: product.name,
  })),
};
---

<BaseLayout
  title="Catálogo de equipos informáticos | Windytech"
  description="Laptops, equipos de escritorio, monitores y accesorios con precios en dólares, disponibilidad actualizada y cotización por WhatsApp. Precios sin IVA."
  path="/catalogo/"
  ogImage="/assets/og.webp"
  ogImageAlt="Catálogo de equipos informáticos de Windytech"
  currencyDefault={currencyDefault}
  extraSchema={[itemListSchema]}
  breadcrumb={[
    { name: 'Inicio', path: '/' },
    { name: 'Catálogo', path: '/catalogo/' },
  ]}
>
  <section class="catalog-hero">
    <img
      class="catalog-hero-art"
      src="/assets/banner-catalogo.webp"
      alt="Computadoras de escritorio, monitores, teclados y equipos de escritorio"
      width="3168"
      height="1344"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="container">
      <div class="catalog-hero-copy">
        <span class="eyebrow">{t.eyebrow}</span>
        <h1>{t.title}</h1>
        <p class="catalog-intro">{t.intro}</p>
        <div class="catalog-hero-meta">
          <span>{t.noTaxNote}</span>
          <CurrencySwitch rate={rate} />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white catalog-section">
    <div class="container">
      <CatalogFilters
        categories={categories}
        brands={brands}
        action="/catalogo/"
        values={{
          q: params.get('q') ?? '',
          category: params.get('category') ?? '',
          condition: params.get('condition') ?? '',
          brand: params.get('brand') ?? '',
          min: params.get('min') ?? '',
          max: params.get('max') ?? '',
        }}
      />

      <div class="catalog-count">
        <strong>{products.length}</strong> {t.results}
      </div>

      <ShareBar
        path="/catalogo/"
        title={`${t.title} | ${site.name}`}
        text={t.intro}
        label={'Comparte el catálogo con tus clientes'}
        campaign="catalog"
        variant="card"
      />

      {products.length === 0 ? (
        <div class="catalog-empty">
          <Icon name="monitor" size={40} />
          <p>{t.emptyDb}</p>
          <a
            class="btn btn-primary"
            href={whatsappLink('Hola Windytech, quiero consultar disponibilidad de equipos.')}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.askAvailability}
          </a>
        </div>
      ) : (
        <div class="product-grid">
          {products.map((product) => (
            <ProductCard product={product} rate={rate} />
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/cart';
</script>
