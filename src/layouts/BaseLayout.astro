---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { content, site, whatsappLink, type Lang } from '../data/site';
import { aboutContent } from '../data/about';
import { customerSessionFromRequest } from '../lib/customer-auth';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  altPath: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  /** Tipo schema.org de la página: WebPage, AboutPage, ContactPage... */
  pageType?: string;
  /** Migas de pan visibles en buscadores. La primera debe ser el inicio. */
  breadcrumb?: BreadcrumbItem[];
  /** Tipo Open Graph: website en inicio, article en artículos. */
  ogType?: 'website' | 'article';
  /** Fecha ISO de la última revisión real del contenido. */
  dateModified?: string;
  /** Preguntas frecuentes de la página; generan schema FAQPage. */
  faq?: FaqItem[];
  /** Nodos JSON-LD adicionales (Service, BlogPosting...) para esta página. */
  extraSchema?: Record<string, unknown>[];
  /** Moneda sugerida para visitantes de Venezuela. */
  currencyDefault?: 'USD' | 'VES';
  /** Oculta el botón flotante de WhatsApp cuando estorba (carrito/panel). */
  hideWhatsappFloat?: boolean;
}

const {
  lang,
  title,
  description,
  path,
  altPath,
  ogImage = site.ogImage,
  ogImageAlt = content[lang].meta.homeOgAlt,
  noindex = false,
  pageType = 'WebPage',
  breadcrumb = [],
  ogType = 'website',
  dateModified = site.contentUpdated,
  faq = [],
  extraSchema = [],
  currencyDefault = 'USD',
  hideWhatsappFloat = false,
} = Astro.props;

const t = content[lang];
const esPath = lang === 'es' ? path : altPath;
const enPath = lang === 'en' ? path : altPath;
const canonical = new URL(path, site.url).toString();
const esUrl = new URL(esPath, site.url).toString();
const enUrl = new URL(enPath, site.url).toString();
const ogImageUrl = new URL(ogImage, site.url).toString();
const logoUrl = new URL(site.logo, site.url).toString();
const skipLabel = lang === 'es' ? 'Saltar al contenido' : 'Skip to content';
const locale = lang === 'es' ? 'es_VE' : 'en_US';
const altLocale = lang === 'es' ? 'en_US' : 'es_VE';
const organisationId = `${site.url}/#organization`;
const websiteId = `${site.url}/#website`;
const logoId = `${site.url}/#logo`;

const isHomePage = path === '/' || path === '/en/';

const customer = await customerSessionFromRequest(Astro.request);

const breadcrumbSchema =
  breadcrumb.length > 0
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: breadcrumb.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: new URL(item.path, site.url).toString(),
        })),
      }
    : null;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: site.name,
      url: site.url,
      description: site.slogan,
      inLanguage: ['es', 'en'],
      publisher: { '@id': organisationId },
    },
    {
      '@type': pageType,
      '@id': `${canonical}#webpage`,
      name: title,
      description,
      url: canonical,
      inLanguage: lang,
      isPartOf: { '@id': websiteId },
      about: { '@id': organisationId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageUrl,
        width: 1200,
        height: 630,
        caption: ogImageAlt,
      },
      datePublished: site.contentUpdated,
      dateModified,
      ...(isHomePage || pageType === 'AboutPage'
        ? { mainEntity: { '@id': organisationId } }
        : {}),
      ...(breadcrumbSchema ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': organisationId,
      name: site.name,
      legalName: site.legalName,
      alternateName: site.alternateName,
      url: site.url,
      slogan: site.slogan,
      description: aboutContent[lang].homeText,
      foundingDate: site.foundingDate,
      logo: {
        '@type': 'ImageObject',
        '@id': logoId,
        url: logoUrl,
        contentUrl: logoUrl,
        width: 512,
        height: 512,
        caption: `${site.name} logo`,
      },
      image: {
        '@type': 'ImageObject',
        '@id': `${site.url}/#primaryimage`,
        url: ogImageUrl,
        contentUrl: ogImageUrl,
        width: 1200,
        height: 630,
        caption: ogImageAlt,
      },
      email: site.email,
      telephone: `+${site.whatsappNumber}`,
      address: {
        '@type': 'PostalAddress',
        addressCountry: site.address.country,
        ...(site.address.region ? { addressRegion: site.address.region } : {}),
        ...(site.address.locality ? { addressLocality: site.address.locality } : {}),
      },
      areaServed: [
        { '@type': 'Country', name: site.address.countryName },
        { '@type': 'Place', name: 'Worldwide' },
      ],
      knowsAbout: [
        ...new Set([
          ...t.services.cards.map(({ title: serviceTitle }) => serviceTitle),
          ...(lang === 'es'
            ? [
                'Desarrollo de software a medida',
                'Automatización de WhatsApp Business',
                'SEO local en Venezuela',
                'Desarrollo web para empresas',
                'Automatización de atención al cliente',
              ]
            : [
                'custom software development',
                'WhatsApp Business automation',
                'SEO services in Venezuela',
                'business website development',
                'customer support automation',
              ]),
        ]),
      ],
      knowsLanguage: ['es', 'en'],
      currenciesAccepted: site.currenciesAccepted,
      paymentAccepted: site.paymentAccepted,
      priceRange: '$$',
      ...(site.sameAs.length > 0 ? { sameAs: site.sameAs } : {}),
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: `+${site.whatsappNumber}`,
        email: site.email,
        contactType: 'sales',
        availableLanguage: ['Spanish', 'English'],
        url: `https://wa.me/${site.whatsappNumber}`,
      },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t.services.title,
        itemListElement: t.services.cards.map((service, index) => {
          const localOnly = /redes|infraestructura|equipos|network|equipment/i.test(
            service.title,
          );

          return {
            '@type': 'ListItem',
            position: index + 1,
            item: {
              '@type': 'Service',
              name: service.title,
              description: service.text,
              provider: { '@id': organisationId },
              areaServed: localOnly
                ? [{ '@type': 'Country', name: site.address.countryName }]
                : [
                    { '@type': 'Country', name: site.address.countryName },
                    { '@type': 'Place', name: 'Worldwide' },
                  ],
            },
          };
        }),
      },
    },
    ...(isHomePage || faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${canonical}#faq`,
            mainEntity: (faq.length > 0 ? faq : t.faqs.items).map(({ question, answer }) => ({
              '@type': 'Question',
              name: question,
              acceptedAnswer: {
                '@type': 'Answer',
                text: answer,
              },
            })),
          },
        ]
      : []),
    ...extraSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0e2234" />
    <meta name="color-scheme" content="light" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="es" href={esUrl} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={esUrl} />}
    {!noindex && (
      <link
        rel="alternate"
        type="text/plain"
        href="/llms.txt"
        title="Windytech — resumen para sistemas de IA"
      />
    )}
    {!noindex && (
      <link
        rel="alternate"
        type="text/plain"
        href="/llms-full.txt"
        title="Windytech — contenido completo para sistemas de IA"
      />
    )}

    <!-- Iconos: Google pide al menos 48x48 y Bing reutiliza el favicon del sitio. -->
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png?v=3" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96.png?v=3" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <meta name="msapplication-TileColor" content="#0e2234" />
    <meta name="msapplication-TileImage" content="/assets/favicon-192.png?v=3" />

    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={altLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    {site.twitter && <meta name="twitter:site" content={site.twitter} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:url" content={canonical} />

    {site.verification.google && (
      <meta name="google-site-verification" content={site.verification.google} />
    )}
    {site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    {site.verification.yandex && (
      <meta name="yandex-verification" content={site.verification.yandex} />
    )}

    <link
      rel="preload"
      href="/assets/fonts/dm-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/outfit-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>
  <body data-currency-default={currencyDefault}>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <Header lang={lang} altHref={altPath} customer={customer} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {!hideWhatsappFloat && (
      <a
        class="wa-float"
        href={whatsappLink(t.whatsapp.general)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.whatsapp.floatLabel}
        data-track="whatsapp"
      >
        <Icon name="whatsapp" size={26} />
      </a>
    )}
    <script>
      import '../scripts/cart';
    </script>
  </body>
</html>
