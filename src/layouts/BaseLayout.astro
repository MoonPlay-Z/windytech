---
import '../styles/global.css';
import '../styles/responsive/index.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { content, site, whatsappLink } from '../data/site';
import { company } from '../data/empresa';
import { customerSessionFromRequest } from '../lib/customer-auth';
import { rawImageUrl } from '../lib/cloudinary';
import { getGlobalSocialShare, type SocialShareConfig } from '../lib/social-share';
import { truncateText } from '../lib/text';

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  /** Tipo schema.org de la página: WebPage, AboutPage, ContactPage... */
  pageType?: string;
  /** Migas de pan visibles en buscadores. La primera debe ser el inicio. */
  breadcrumb?: BreadcrumbItem[];
  /** Tipo Open Graph: website en inicio, article en artículos. */
  ogType?: 'website' | 'article';
  /** Fecha ISO de la última revisión real del contenido. */
  dateModified?: string;
  /** Preguntas frecuentes de la página; generan schema FAQPage. */
  faq?: FaqItem[];
  /** Nodos JSON-LD adicionales (Service, BlogPosting...) para esta página. */
  extraSchema?: Record<string, unknown>[];
  /** Etiquetas meta extra para redes (product:price, article:published_time...). */
  extraMeta?: Record<string, string>[];
  /** Moneda sugerida para visitantes de Venezuela. */
  currencyDefault?: 'USD' | 'VES';
  /** Oculta el botón flotante de WhatsApp cuando estorba (carrito/panel). */
  hideWhatsappFloat?: boolean;
  /**
   * Tarjeta personalizada para redes sociales. `undefined` usa la global;
   * `null` conserva la imagen propia de la página.
   */
  socialShare?: SocialShareConfig | null;
}

const {
  title,
  description,
  path,
  ogImage = site.ogImage,
  ogImageAlt = content.meta.homeOgAlt,
  noindex = false,
  pageType = 'WebPage',
  breadcrumb = [],
  ogType = 'website',
  dateModified = site.contentUpdated,
  faq = [],
  extraSchema = [],
  extraMeta = [],
  currencyDefault = 'USD',
  hideWhatsappFloat = false,
  socialShare,
} = Astro.props;

const t = content;
const canonical = new URL(path, site.url).toString();
const ogImageUrl = new URL(ogImage, site.url).toString();
const logoUrl = new URL(site.logo, site.url).toString();
const skipLabel = 'Saltar al contenido';

/*
 * Tarjeta social: si la página no pasa una tarjeta explícita se usa la
 * global. `socialShare={null}` conserva la imagen propia (productos con foto,
 * publicaciones y proyectos con portada).
 */
const resolvedSocialShare =
  socialShare === undefined ? (await getGlobalSocialShare()).config : socialShare;
const activeShare = resolvedSocialShare?.enabled ? resolvedSocialShare : null;
const shareImage = activeShare?.imagePublicId
  ? rawImageUrl(activeShare.imagePublicId)
  : '';
const socialImageUrl = shareImage || ogImageUrl;
const socialImageType = shareImage ? 'image/jpeg' : 'image/webp';
const socialImageWidth = shareImage ? activeShare?.imageWidth || 1200 : 1200;
const socialImageHeight = shareImage ? activeShare?.imageHeight || 630 : 630;
const socialTitle = activeShare?.message?.trim() || title;
const socialDescription = activeShare?.subtitle?.trim() || description;
const socialSiteName = activeShare?.companyName?.trim() || site.name;
const socialImageAlt = activeShare?.message?.trim()
  ? `${activeShare.message.trim()} — ${socialSiteName}`
  : ogImageAlt;

// Los buscadores y las redes cortan las descripciones largas: se recortan aquí
// para controlar el texto que se muestra (el JSON-LD conserva la completa).
const metaDescription = truncateText(description);
const socialDescriptionText = truncateText(socialDescription);

const organisationId = `${site.url}/#organization`;
const websiteId = `${site.url}/#website`;
const logoId = `${site.url}/#logo`;

const isHomePage = path === '/' || path === '/en/';

const customer = await customerSessionFromRequest(Astro.request);

const breadcrumbSchema =
  breadcrumb.length > 0
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonical}#breadcrumb`,
        itemListElement: breadcrumb.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: new URL(item.path, site.url).toString(),
        })),
      }
    : null;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: site.name,
      url: site.url,
      description: site.slogan,
      inLanguage: ['es', 'en'],
      publisher: { '@id': organisationId },
    },
    {
      '@type': pageType,
      '@id': `${canonical}#webpage`,
      name: title,
      description,
      url: canonical,
      inLanguage: 'es',
      isPartOf: { '@id': websiteId },
      about: { '@id': organisationId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImageUrl,
        width: 1200,
        height: 630,
        caption: ogImageAlt,
      },
      datePublished: site.contentUpdated,
      dateModified,
      ...(isHomePage || pageType === 'AboutPage'
        ? { mainEntity: { '@id': organisationId } }
        : {}),
      ...(breadcrumbSchema ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
    },
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': organisationId,
      name: site.name,
      legalName: site.legalName,
      alternateName: site.alternateName,
      url: site.url,
      slogan: site.slogan,
      description: company.description,
      foundingDate: site.foundingDate,
      logo: {
        '@type': 'ImageObject',
        '@id': logoId,
        url: logoUrl,
        contentUrl: logoUrl,
        width: 512,
        height: 512,
        caption: `${site.name} logo`,
      },
      image: {
        '@type': 'ImageObject',
        '@id': `${site.url}/#primaryimage`,
        url: ogImageUrl,
        contentUrl: ogImageUrl,
        width: 1200,
        height: 630,
        caption: ogImageAlt,
      },
      email: site.email,
      telephone: `+${site.whatsappNumber}`,
      address: {
        '@type': 'PostalAddress',
        addressCountry: site.address.country,
        ...(site.address.region ? { addressRegion: site.address.region } : {}),
        ...(site.address.locality ? { addressLocality: site.address.locality } : {}),
      },
      areaServed: [
        ...company.areaServed.map((area) => ({
          '@type': area.type === 'Country' ? 'Country' : area.type,
          name: area.name,
        })),
      ],
      // Horario de atención: Google lo muestra en el panel lateral.
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: [...company.openingHours.days],
          opens: company.openingHours.opens,
          closes: company.openingHours.closes,
        },
        ...(company.openingHours.holidays ?? []).map((holiday) => ({
          '@type': 'OpeningHoursSpecification',
          validFrom: holiday,
          opens: '00:00',
          closes: '00:00',
        })),
      ],
      // Categoría principal de Google Business Profile: el buscador la usa
      // para clasificar la empresa en el panel.
      ...(company.categories.main ? { additionalType: company.categories.main } : {}),
      timeZone: company.timeZone,
      knowsAbout: [
        ...new Set([
          ...t.services.cards.map(({ title: serviceTitle }) => serviceTitle),
          'Desarrollo de software a medida',
          'Automatización de WhatsApp Business',
          'SEO local en Venezuela',
          'Desarrollo web para empresas',
          'Automatización de atención al cliente',
        ]),
      ],
      knowsLanguage: [
        company.languages.primary,
        ...company.languages.additional,
      ],
      currenciesAccepted: site.currenciesAccepted,
      paymentAccepted: site.paymentAccepted,
      priceRange: company.priceRange,
      ...(site.sameAs.length > 0 ? { sameAs: site.sameAs } : {}),
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: `+${site.whatsappNumber}`,
          email: site.email,
          contactType: 'sales',
          availableLanguage: ['Spanish', 'English'],
          url: `https://wa.me/${site.whatsappNumber}`,
        },
        {
          '@type': 'ContactPoint',
          telephone: `+${site.whatsappNumber}`,
          contactType: 'customer service',
          availableLanguage: ['Spanish', 'English'],
          areaServed: 'Worldwide',
          url: `https://wa.me/${site.whatsappNumber}`,
        },
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t.services.title,
        itemListElement: t.services.cards.map((service, index) => {
          const localOnly = /redes|infraestructura|equipos|network|equipment/i.test(
            service.title,
          );

          return {
            '@type': 'ListItem',
            position: index + 1,
            item: {
              '@type': 'Service',
              name: service.title,
              description: service.text,
              provider: { '@id': organisationId },
              areaServed: localOnly
                ? [{ '@type': 'Country', name: site.address.countryName }]
                : [
                    { '@type': 'Country', name: site.address.countryName },
                    { '@type': 'Place', name: 'Worldwide' },
                  ],
            },
          };
        }),
      },
    },
    ...(isHomePage || faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${canonical}#faq`,
            mainEntity: (faq.length > 0 ? faq : t.faqs.items).map(({ question, answer }) => ({
              '@type': 'Question',
              name: question,
              acceptedAnswer: {
                '@type': 'Answer',
                text: answer,
              },
            })),
          },
        ]
      : []),
    ...extraSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0e2234" />
    <meta name="color-scheme" content="light" />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, follow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={`Blog de ${site.name} (RSS)`}
        href="/blog/rss.xml"
      />
    )}
    {!noindex && (
      <link
        rel="alternate"
        type="text/plain"
        href="/llms.txt"
        title="Windytech — resumen para sistemas de IA"
      />
    )}
    {!noindex && (
      <link
        rel="alternate"
        type="text/plain"
        href="/llms-full.txt"
        title="Windytech — contenido completo para sistemas de IA"
      />
    )}

    <!-- Iconos: Google pide al menos 48x48 y Bing reutiliza el favicon del sitio. -->
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-48.png?v=3" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96.png?v=3" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <meta name="msapplication-TileColor" content="#0e2234" />
    <meta name="msapplication-TileImage" content="/assets/favicon-192.png?v=3" />

    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={socialSiteName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescriptionText} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:locale" content="es_VE" />

    <meta name="twitter:card" content="summary_large_image" />
    {site.twitter && <meta name="twitter:site" content={site.twitter} />}
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescriptionText} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="twitter:url" content={canonical} />

    {extraMeta.map((meta) => (
      <meta {...meta} />
    ))}

    {site.verification.google && (
      <meta name="google-site-verification" content={site.verification.google} />
    )}
    {site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}
    {site.verification.brave && <meta name="brave-site-verification" content={site.verification.brave} />}
    {site.verification.yandex && (
      <meta name="yandex-verification" content={site.verification.yandex} />
    )}

    <link
      rel="preload"
      href="/assets/fonts/dm-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/assets/fonts/outfit-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph).replace(/</g, '\\u003c')} />
    <ClientRouter />
  </head>
  <body data-currency-default={currencyDefault}>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <Header customer={customer} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!hideWhatsappFloat && (
      <a
        class="wa-float"
        href={whatsappLink(t.whatsapp.general)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.whatsapp.floatLabel}
        data-track="whatsapp"
      >
        <Icon name="whatsapp" size={26} />
      </a>
    )}
    <script>
      import '../scripts/cart';
      import '../scripts/float';
      import '../scripts/attribution';
    </script>
  </body>
</html>
