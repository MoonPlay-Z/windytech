---
import BaseLayout from '../layouts/BaseLayout.astro';
import { legalContent, type LegalSection } from '../data/legal';
import { site } from '../data/site';

interface Props {
  docType: 'privacy' | 'terms';
  path: string;
}

const { docType, path } = Astro.props;
const doc = legalContent[docType];
const sections = doc.sections as readonly LegalSection[];
const homeHref = '/';
const backLabel = 'Volver al inicio';
---

<BaseLayout
  title={`${doc.title} | ${site.name}`}
  description={doc.intro}
  path={path}
  ogImage={'/assets/og.webp'}
  ogImageAlt={`${doc.title} — ${site.name}`}
  breadcrumb={[
    { name: 'Inicio', path: homeHref },
    { name: doc.title, path },
  ]}
>
  <div class="legal-page">
    <section class="legal-hero">
      <div class="container">
        <span class="eyebrow">{site.name}</span>
        <h1>{doc.title}</h1>
        <p>{doc.updated}</p>
      </div>
    </section>

    <section class="legal-content">
      <div class="container">
        <p class="legal-intro">{doc.intro}</p>

        {sections.map((section) => (
          <div class="legal-section">
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </div>
        ))}

        <a class="legal-back" href={homeHref}>← {backLabel}</a>
      </div>
    </section>
  </div>
</BaseLayout>
