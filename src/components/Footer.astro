---
import { content, site } from '../data/site';
import { company } from '../data/empresa';
import { servicePath, services } from '../data/services';
import { CITIES, STATES } from '../data/ciudades';
import Icon from './Icon.astro';

interface Props {
}

const t = content;
const homeHref = '/';
const navAria = 'Navegación del pie de página';
const servicesAria = 'Servicios de Windytech';
const servicesTitle = 'Servicios';
const servicesHub = '/servicios/';
const servicesHubLabel = 'Todos los servicios';
const statesTitle = 'Estados donde trabajamos';
const wordmarkAlt =
  'Windytech — desarrollo de software y automatización';
/* Perfiles sociales reales: enlazados desde el pie para reforzar la entidad. */
const socialLinks = company.profiles.filter((profile) => profile.url.trim().length > 0);
/* Cada estado lleva sus ciudades para que el visitante sepa dónde hay base. */
const estados = STATES.map((state) => ({
  name: state.name,
  cities: CITIES.filter((city) => city.state === state.name),
}));
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <img
        class="footer-wordmark"
        src="/assets/logo-wordmark-light-430.webp"
        alt={wordmarkAlt}
        width="300"
        height="68"
        loading="lazy"
      />
      <span class="footer-tagline">{t.footer.tagline}</span>
      <p class="footer-description">{company.description}</p>
      {
        socialLinks.length > 0 && (
          <nav class="footer-social" aria-label="Redes sociales de Windytech">
            {socialLinks.map((profile) => (
              <a
                href={profile.url}
                target="_blank"
                rel="noopener noreferrer"
                data-track="social"
              >
                <Icon
                  name={profile.name.toLowerCase() === 'x' ? 'x' : profile.name.toLowerCase()}
                  size={18}
                />
                <span>{profile.name}</span>
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <nav class="footer-nav" aria-label={navAria}>
      <span class="footer-nav-title">Navegación</span>
      <div class="footer-nav-links">
        {t.nav.items.map((item) => (
          <a href={item.href.startsWith('/') ? item.href : `${homeHref}${item.href}`}>
            {item.label}
          </a>
        ))}
        <a href={t.nav.aboutHref}>{t.nav.about}</a>
      </div>
    </nav>
  </div>

  <div class="container footer-services">
    <span class="footer-services-title">{servicesTitle}</span>
    <nav class="footer-services-links" aria-label={servicesAria}>
      <a href={servicesHub}>{servicesHubLabel}</a>
      {services.map((service) => (
        <a href={servicePath(service)}>{service.content.title}</a>
      ))}
    </nav>
  </div>

  <div class="container footer-services">
    <span class="footer-services-title">{statesTitle}</span>
    <nav class="footer-services-links" aria-label={statesTitle}>
      {
        estados.map((state) => (
          <div class="footer-state">
            <span class="footer-state-name">{state.name}</span>
            <span class="footer-state-cities">
              {state.cities.map((city, index) => (
                <>
                  {index > 0 && ', '}
                  <a href={`/${city.slug}/`}>{city.name}</a>
                </>
              ))}
            </span>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container footer-bottom">
    <span>© {site.year} {site.name}. {t.footer.rights}</span>
    <div class="footer-legal">
      <a href={t.footer.legalPaths.privacy}>{t.footer.privacy}</a>
      <a href={t.footer.legalPaths.terms}>{t.footer.terms}</a>
    </div>
  </div>
</footer>
