---
import Icon from './Icon.astro';
import ShareMenu from './ShareMenu.astro';
import { whatsappLink } from '../data/site';
import { formatUsd, formatVes } from '../lib/money';
import { shareCopy } from '../lib/social';
import type { ServicePlan } from '../lib/catalog';

interface Props {
  plan: ServicePlan;
  /** Enlace al servicio relacionado (página de detalle). */
  serviceHref?: string;
  /** URL absoluta que se copia al compartir este paquete. */
  shareUrl?: string;
  /** Etiqueta del botón de WhatsApp. */
  ctaLabel?: string;
  /** Etiqueta del enlace al servicio. */
  viewServiceLabel?: string;
}

const { plan, serviceHref = '', shareUrl = '', ctaLabel, viewServiceLabel } = Astro.props;
const copy = shareCopy;

const money = (value: ServicePlan) =>
  value.currency === 'VES' ? formatVes(value.priceCents) : formatUsd(value.priceCents);

const periodLabel = { one_time: 'pago único', monthly: 'por mes', yearly: 'por año' };

const message = `Hola Windytech, quiero el paquete ${plan.name}.`;
---

<article class:list={['plan-card', { 'plan-card--featured': plan.isFeatured }]} id={`plan-${plan.slug}`}>
  {plan.badge && <span class="plan-badge">{plan.badge}</span>}
  <h3 class="plan-name">{plan.name}</h3>
  {plan.tagline && <p class="plan-tagline">{plan.tagline}</p>}

  <p class="plan-price">
    <span class="plan-price-value">{money(plan)}</span>
    <span class="plan-price-period">{periodLabel[plan.billingPeriod] ?? periodLabel.one_time}</span>
  </p>

  {plan.deliveryTime && (
    <p class="plan-delivery">
      <Icon name="clock" size={16} />
      <span>
        <strong>{`${'Tiempo de aplicación'}: `}</strong>
        {plan.deliveryTime}
      </span>
    </p>
  )}

  {plan.includes.length > 0 && (
    <>
      <span class="plan-includes-title">{'Incluye'}</span>
      <ul class="plan-features">
        {plan.includes.map((item) => (
          <li>
            <Icon name="check" size={16} />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <div class="plan-actions">
    <a
      class:list={['btn', plan.isFeatured ? 'btn-light' : 'btn-primary']}
      href={whatsappLink(message)}
      target="_blank"
      rel="noopener noreferrer"
      data-track="whatsapp"
    >
      {ctaLabel ?? ('Contratar por WhatsApp')}
      <Icon name="whatsapp" size={18} />
    </a>
    {serviceHref && (
      <a class="plan-link" href={serviceHref}>
        {viewServiceLabel ?? ('Ver servicio')}
        <Icon name="arrow-right" size={16} />
      </a>
    )}
    <ShareMenu
      path={shareUrl}
      title={plan.name}
      text={plan.tagline}
      label="Compartir"
      campaign="plan"
    />
  </div>
</article>
