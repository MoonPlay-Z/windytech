---
import Icon from './Icon.astro';
import { content, site, whatsappLink } from '../data/site';

interface Props {
}

const t = content;
const f = t.contact.form;
---

<form
  class="contact-form"
  data-contact-form
  data-wa-number={site.whatsappNumber}
>
  <div class="form-row">
    <div class="field">
      <label for="nombre">{f.name}</label>
      <input
        id="nombre"
        name="name"
        type="text"
        placeholder={f.namePlaceholder}
        autocomplete="name"
        required
      />
    </div>
    <div class="field">
      <label for="empresa">{f.business}</label>
      <input
        id="empresa"
        name="business"
        type="text"
        placeholder={f.businessPlaceholder}
        autocomplete="organization"
      />
    </div>
  </div>

  <div class="field">
    <label for="servicio">{f.service}</label>
    <select id="servicio" name="service" required>
      {f.options.map((option) => <option value={option}>{option}</option>)}
    </select>
  </div>

  <div class="form-row">
    <div class="field">
      <label for="telefono">{f.phone}</label>
      <input
        id="telefono"
        name="phone"
        type="tel"
        placeholder={f.phonePlaceholder}
        autocomplete="tel"
        maxlength="40"
      />
    </div>
    <div class="field">
      <label for="correo">{f.email}</label>
      <input
        id="correo"
        name="email"
        type="email"
        placeholder={f.emailPlaceholder}
        autocomplete="email"
        maxlength="200"
      />
    </div>
  </div>

  <div class="field">
    <label for="mensaje">{f.message}</label>
    <textarea
      id="mensaje"
      name="message"
      placeholder={f.messagePlaceholder}
      rows="4"
      required
    ></textarea>
  </div>

  <button class="btn btn-primary" type="submit" data-track="lead-form">
    {f.submit}
    <Icon name="whatsapp" size={18} />
  </button>

  <p class="form-status" data-contact-status role="status" hidden></p>

  <a
    class="btn btn-light contact-whatsapp"
    href={whatsappLink(t.whatsapp.general)}
    target="_blank"
    rel="noopener noreferrer"
    data-contact-whatsapp
    hidden
  >
    <Icon name="whatsapp" size={18} />
    Continuar por WhatsApp
  </a>

  <p class="form-note">
    {f.note}
    <br />
    {f.emailFallback}
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>

  <noscript>
    <p class="form-note">
      {'Para enviar el formulario, activa JavaScript o escríbenos directamente por '}
      <a href={whatsappLink(t.whatsapp.general)}>WhatsApp</a>.
    </p>
  </noscript>
</form>

<script>
  import { content } from '../data/site';
  import { readAttribution } from '../lib/attribution';

  // Si la visita viene de una campaña, dejamos el formulario preparado.
  function prefillFromCampaign(form: HTMLFormElement) {
    // La atribución puede llegar por la URL o por la cookie de la visita.
    const params = new URLSearchParams(window.location.search);
    const campaign = params.get('utm_campaign') ?? readAttribution().campaign ?? '';
    if (!campaign) return;
    const card = content.campaigns.cards.find((item: (typeof content.campaigns.cards)[number]) => item.slug === campaign);
    if (!card) return;

    const select = form.querySelector<HTMLSelectElement>('[name="service"]');
    if (select) {
      const option = [...select.options].find((item) => item.value === card.service);
      if (option) select.value = option.value;
    }
    const message = form.querySelector<HTMLTextAreaElement>('[name="message"]');
    if (message && !message.value) {
      message.value = `Me interesa la campaña «${card.tag}».`;
    }
  }

  function initContactForms() {
    document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
      if (form.dataset.wtBound === 'true') return;
      form.dataset.wtBound = 'true';
      prefillFromCampaign(form);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const name = String(data.get('name') ?? '').trim();
        const business = String(data.get('business') ?? '').trim();
        const service = String(data.get('service') ?? '').trim();
        const message = String(data.get('message') ?? '').trim();
        const phone = String(data.get('phone') ?? '').trim();
        const email = String(data.get('email') ?? '').trim();
        const number = form.dataset.waNumber ?? '584127723148';

        const status = form.querySelector<HTMLElement>('[data-contact-status]');
        const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');
        const intro = `Hola Windytech, soy ${name}${business ? ` de ${business}` : ''}. Me interesa ${service}.`;
        const text = `${intro}${message ? `\n\n${message}` : ''}`;
        const whatsappUrl = `https://wa.me/${number}?text=${encodeURIComponent(text)}`;

        // 1) Guardamos la consulta (no se pierde aunque el cliente no use WhatsApp).
        if (submit) submit.disabled = true;
        if (status) status.textContent = 'Enviando tu consulta…';

        try {
          const response = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({
              name,
              business,
              phone,
              email,
              service,
              message,
              channel: 'web',
              source: window.windych?.source ?? '',
              campaign: window.windych?.campaign ?? '',
            }),
          });

          const result = (await response.json().catch(() => ({}))) as { error?: string };
          if (!response.ok) throw new Error(result.error ?? 'No se pudo enviar la consulta.');

          // 2) Confirmación y atajo a WhatsApp con el mensaje ya escrito.
          if (status) {
            status.textContent = '¡Recibimos tu consulta! Te respondemos muy pronto.';
            status.dataset.kind = 'ok';
          }
          form.dataset.sent = 'true';
          const waLink = form.querySelector<HTMLAnchorElement>('[data-contact-whatsapp]');
          if (waLink) {
            waLink.href = whatsappUrl;
            waLink.hidden = false;
          }
        } catch (error) {
          if (status) {
            status.textContent =
              error instanceof Error
                ? error.message
                : 'No se pudo enviar. Escríbenos por WhatsApp.';
            status.dataset.kind = 'error';
          }
          const waLink = form.querySelector<HTMLAnchorElement>('[data-contact-whatsapp]');
          if (waLink) {
            waLink.href = whatsappUrl;
            waLink.hidden = false;
          }
        } finally {
          if (submit) submit.disabled = false;
        }
      });
    });
  }

  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>
