---
import Icon from './Icon.astro';
import { content, site, whatsappLink } from '../data/site';

interface Props {
}

const t = content;
const f = t.contact.form;
---

<form
  class="contact-form"
  data-contact-form
  data-wa-number={site.whatsappNumber}
>
  <div class="form-row">
    <div class="field">
      <label for="nombre">{f.name}</label>
      <input
        id="nombre"
        name="name"
        type="text"
        placeholder={f.namePlaceholder}
        autocomplete="name"
        required
      />
    </div>
    <div class="field">
      <label for="empresa">{f.business}</label>
      <input
        id="empresa"
        name="business"
        type="text"
        placeholder={f.businessPlaceholder}
        autocomplete="organization"
      />
    </div>
  </div>

  <div class="field">
    <label for="servicio">{f.service}</label>
    <select id="servicio" name="service" required>
      {f.options.map((option) => <option value={option}>{option}</option>)}
    </select>
  </div>

  <div class="field">
    <label for="mensaje">{f.message}</label>
    <textarea
      id="mensaje"
      name="message"
      placeholder={f.messagePlaceholder}
      rows="4"
      required
    ></textarea>
  </div>

  <button class="btn btn-primary" type="submit" data-track="whatsapp-form">
    {f.submit}
    <Icon name="whatsapp" size={18} />
  </button>

  <p class="form-note">
    {f.note}
    <br />
    {f.emailFallback}
    <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>

  <noscript>
    <p class="form-note">
      {'Para enviar el formulario, activa JavaScript o escríbenos directamente por '}
      <a href={whatsappLink(t.whatsapp.general)}>WhatsApp</a>.
    </p>
  </noscript>
</form>

<script>
  function initContactForms() {
    document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
      if (form.dataset.wtBound === 'true') return;
      form.dataset.wtBound = 'true';

      form.addEventListener('submit', (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const name = String(data.get('name') ?? '').trim();
        const business = String(data.get('business') ?? '').trim();
        const service = String(data.get('service') ?? '').trim();
        const message = String(data.get('message') ?? '').trim();
        const number = form.dataset.waNumber ?? '584127723148';

        const intro = `Hola Windytech, soy ${name}${business ? ` de ${business}` : ''}. Me interesa ${service}.`;

        const text = `${intro}${message ? `\n\n${message}` : ''}`;
        const url = `https://wa.me/${number}?text=${encodeURIComponent(text)}`;

        window.open(url, '_blank', 'noopener,noreferrer');
      });
    });
  }

  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>
