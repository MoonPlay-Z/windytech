---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { aboutContent } from '../data/about';
import { company } from '../data/empresa';
import { site, whatsappLink } from '../data/site';
import { servicePath, services } from '../data/services';

interface Props {
  path: string;
}

const { path } = Astro.props;
const a = aboutContent;
const homeHref = '/';
const homeLabel = 'Inicio';
const whatsappMessage = 'Hola Windytech, quiero una cotización para mi negocio.';
---

<BaseLayout
  title={a.pageTitle}
  description={a.pageDescription}
  path={path}
  ogImage={'/assets/og.webp'}
  ogImageAlt={`${a.pageH1} — ${site.name}`}
  pageType="AboutPage"
  breadcrumb={[
    { name: homeLabel, path: homeHref },
    { name: a.pageH1, path },
  ]}
>
  <section class="about-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={'Ruta de navegación'}>
        <a href={homeHref}>{homeLabel}</a>
        <span aria-hidden="true">/</span>
        <span>{a.pageH1}</span>
      </nav>
      <span class="eyebrow">{a.eyebrow}</span>
      <h1>{a.pageH1}</h1>
      <p class="about-intro">{a.intro}</p>
      <div class="about-hero-actions">
        <a
          class="btn btn-primary"
          href={whatsappLink(whatsappMessage)}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp"
        >
          {a.ctaButton}
          <Icon name="whatsapp" size={18} />
        </a>
        <a class="btn btn-light" href={`${homeHref}#servicios`}>
          {'Ver servicios'}
        </a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container about-page-grid">
      <article class="about-page-main">
        <h2>{a.definitionTitle}</h2>
        {a.definition.map((paragraph) => <p>{paragraph}</p>)}

        <div class="about-pillars">
          <article class="about-pillar">
            <h2>{a.missionTitle}</h2>
            <p>{a.missionText}</p>
          </article>
          <article class="about-pillar">
            <h2>{a.visionTitle}</h2>
            <p>{a.visionText}</p>
          </article>
        </div>

        <h2>{a.objectivesTitle}</h2>
        <ul class="about-service-list">
          {a.objectives.map((objective) => (
            <li>
              <Icon name="check" size={20} />
              <span>{objective}</span>
            </li>
          ))}
        </ul>

        <h2>{a.servicesTitle}</h2>
        <ul class="about-service-list">
          {a.services.map((serviceText, index) => (
            <li>
              <Icon name="check" size={20} />
              {services[index] ? (
                <a href={servicePath(services[index])}>{serviceText}</a>
              ) : (
                <span>{serviceText}</span>
              )}
            </li>
          ))}
        </ul>

        <h2>{a.processTitle}</h2>
        <ol class="about-steps">
          {a.process.map((step, index) => (
            <li>
              <span class="about-step-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>
                <strong>{step.title}</strong>
                {step.text}
              </span>
            </li>
          ))}
        </ol>

        <h2>{a.coverageTitle}</h2>
        {a.coverage.map((paragraph) => <p>{paragraph}</p>)}

        <h2>{a.companyCardTitle}</h2>
        <p>{a.companyCardText}</p>
        <dl class="about-company-grid">
          <div>
            <dt>{a.companyCardName}</dt>
            <dd>{company.name}</dd>
          </div>
          <div>
            <dt>{a.companyCardFounded}</dt>
            <dd>{company.foundingDate}</dd>
          </div>
          <div>
            <dt>{a.companyCardCategory}</dt>
            <dd>{company.categories.main}</dd>
          </div>
          <div>
            <dt>{a.companyCardHours}</dt>
            <dd>
              {company.openingHours.days
                .map((day) => day.slice(0, 3))
                .join(', ')}{' '}
              · {company.openingHours.opens}–{company.openingHours.closes}
            </dd>
          </div>
          <div>
            <dt>{a.companyCardPhone}</dt>
            <dd>
              <a href={`tel:${company.phone}`}>{company.phoneDisplay}</a>
            </dd>
          </div>
          <div>
            <dt>{a.companyCardEmail}</dt>
            <dd>
              <a href={`mailto:${company.email}`}>{company.email}</a>
            </dd>
          </div>
          <div>
            <dt>{a.companyCardCoverage}</dt>
            <dd>{company.areaServed.map((area) => area.name).join(' · ')}</dd>
          </div>
          <div>
            <dt>{a.companyCardPrices}</dt>
            <dd>{company.priceRange} — {company.priceRangeReason}</dd>
          </div>
        </dl>
        <p class="about-company-note">{company.remoteNote}</p>
      </article>

      <aside class="about-page-aside">
        <div class="about-facts-card">
          <h2>{a.factsTitle}</h2>
          <dl class="about-page-facts">
            {a.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="about-contact-card">
          <h2>{a.ctaTitle}</h2>
          <p>{a.ctaText}</p>
          <a
            class="btn btn-primary"
            href={whatsappLink(whatsappMessage)}
            target="_blank"
            rel="noopener noreferrer"
            data-track="whatsapp"
          >
            {a.ctaButton}
            <Icon name="whatsapp" size={18} />
          </a>
          <a class="text-link" href={homeHref}>
            {a.backHome}
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
