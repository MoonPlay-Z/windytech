---
import Icon from './Icon.astro';
import PlanCard from './PlanCard.astro';
import { site, type Lang } from '../data/site';
import { services } from '../data/services';
import { shareCopy, shareLinks } from '../lib/social';
import type { ServicePlan } from '../lib/catalog';

interface Props {
  lang: Lang;
  plans: ServicePlan[];
}

const { lang, plans } = Astro.props;
const es = lang === 'es';
const servicesHref = es ? '/servicios/' : '/en/services/';

const copy = {
  es: {
    eyebrow: 'PAQUETES Y PLANES',
    title: 'Elige el paquete que se aplica a tu negocio',
    intro:
      'Cada paquete indica qué incluye, cuánto cuesta y en cuánto tiempo se aplica. Si ninguno encaja, cotizamos a medida.',
    shareLabel: 'Comparte el catálogo con tus clientes',
    shareText: 'Estos son los paquetes de servicios de Windytech, con precio y tiempo de aplicación:',
  },
  en: {
    eyebrow: 'PACKAGES AND PLANS',
    title: 'Choose the package that fits your business',
    intro:
      'Every package shows what it includes, what it costs and how long it takes to apply. If none fits, we quote it to measure.',
    shareLabel: 'Share the catalog with your customers',
    shareText: 'These are the Windytech service packages, with price and delivery time:',
  },
} as const;

const t = copy[lang];
const shareCopyText = shareCopy[lang];
const catalogUrl = new URL(servicesHref, site.url).toString();
const catalogShare = shareLinks({
  url: catalogUrl,
  title: es ? 'Paquetes de servicios Windytech' : 'Windytech service packages',
  text: t.shareText,
  lang,
  campaign: 'plans',
});
---

{
  plans.length > 0 && (
    <section class="section section--white" id="paquetes">
      <div class="container">
        <div class="plans-head">
          <span class="eyebrow">{t.eyebrow}</span>
          <h2>{t.title}</h2>
          <p>{t.intro}</p>
        </div>

        <div class="plan-grid">
          {plans.map((plan) => {
            const service = services.find((item) => item.id === plan.serviceKey);
            const serviceHref = service ? (es ? service.pathEs : service.pathEn) : '';
            return (
              <PlanCard
                plan={plan}
                lang={lang}
                serviceHref={serviceHref}
                shareUrl={new URL(`${servicesHref}#plan-${plan.slug}`, site.url).toString()}
              />
            );
          })}
        </div>

        <div class="share-box share-box--inline plans-share" data-share-group>
          <p class="share-box-label">{t.shareLabel}</p>
          <nav class="share-actions" aria-label={shareCopyText.navLabel}>
            {catalogShare.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.label}
                data-share-channel={link.id}
                data-track={`share-${link.id}`}
              >
                <Icon name={link.icon} size={18} />
                <span>{link.label}</span>
              </a>
            ))}
            <button
              type="button"
              data-copy-share
              data-copy-url={catalogUrl}
              data-copy-label={shareCopyText.copy}
              data-copied-label={shareCopyText.copied}
              data-error-label={shareCopyText.copyError}
            >
              <Icon name="copy" size={18} />
              <span>{shareCopyText.copy}</span>
            </button>
          </nav>
          <span class="share-status" data-share-status aria-live="polite"></span>
        </div>
      </div>
    </section>
  )
}

<script>
  import '../scripts/share';
</script>
