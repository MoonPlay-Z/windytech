---
import Icon from './Icon.astro';
import { whatsappLink, type Lang } from '../data/site';
import { services } from '../data/services';
import { formatUsd, formatVes } from '../lib/money';
import type { ServicePlan } from '../lib/catalog';

interface Props {
  lang: Lang;
  plans: ServicePlan[];
}

const { lang, plans } = Astro.props;
const es = lang === 'es';

const copy = {
  es: {
    eyebrow: 'PAQUETES Y PLANES',
    title: 'Elige el paquete que se aplica a tu negocio',
    intro:
      'Cada paquete indica qué incluye, cuánto cuesta y en cuánto tiempo se aplica. Si ninguno encaja, cotizamos a medida.',
    cta: 'Contratar por WhatsApp',
    includes: 'Incluye',
    delivery: 'Tiempo de aplicación',
    period: { one_time: 'pago único', monthly: 'por mes', yearly: 'por año' },
    viewService: 'Ver servicio',
    priceFrom: 'desde',
  },
  en: {
    eyebrow: 'PACKAGES AND PLANS',
    title: 'Choose the package that fits your business',
    intro:
      'Every package shows what it includes, what it costs and how long it takes to apply. If none fits, we quote it to measure.',
    cta: 'Start on WhatsApp',
    includes: 'Includes',
    delivery: 'Delivery time',
    period: { one_time: 'one-time', monthly: 'per month', yearly: 'per year' },
    viewService: 'View service',
    priceFrom: 'from',
  },
} as const;

const t = copy[lang];

const money = (plan: ServicePlan) =>
  plan.currency === 'VES' ? formatVes(plan.priceCents) : formatUsd(plan.priceCents);

const periodLabel = (plan: ServicePlan) =>
  t.period[plan.billingPeriod as keyof typeof t.period] ?? t.period.one_time;

const serviceFor = (key: string) => services.find((service) => service.id === key);
---

{
  plans.length > 0 && (
    <section class="section section--white" id="paquetes">
      <div class="container">
        <div class="plans-head">
          <span class="eyebrow">{t.eyebrow}</span>
          <h2>{t.title}</h2>
          <p>{t.intro}</p>
        </div>

        <div class="plan-grid">
          {plans.map((plan) => {
            const service = serviceFor(plan.serviceKey);
            const serviceHref = service ? (es ? service.pathEs : service.pathEn) : '';
            return (
              <article class:list={['plan-card', { 'plan-card--featured': plan.isFeatured }]}>
                {plan.badge && <span class="plan-badge">{plan.badge}</span>}
                <h3 class="plan-name">{plan.name}</h3>
                {plan.tagline && <p class="plan-tagline">{plan.tagline}</p>}

                <p class="plan-price">
                  <span class="plan-price-value">{money(plan)}</span>
                  <span class="plan-price-period">{periodLabel(plan)}</span>
                </p>

                {plan.deliveryTime && (
                  <p class="plan-delivery">
                    <Icon name="clock" size={16} />
                    <span>
                      <strong>{`${t.delivery}: `}</strong>
                      {plan.deliveryTime}
                    </span>
                  </p>
                )}

                {plan.includes.length > 0 && (
                  <>
                    <span class="plan-includes-title">{t.includes}</span>
                    <ul class="plan-features">
                      {plan.includes.map((item) => (
                        <li>
                          <Icon name="check" size={16} />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                <div class="plan-actions">
                  <a
                    class:list={['btn', plan.isFeatured ? 'btn-light' : 'btn-primary']}
                    href={whatsappLink(
                      es
                        ? `Hola Windytech, quiero el paquete ${plan.name}.`
                        : `Hello Windytech, I would like the ${plan.name} package.`,
                    )}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="whatsapp"
                  >
                    {t.cta}
                    <Icon name="whatsapp" size={18} />
                  </a>
                  {serviceHref && (
                    <a class="plan-link" href={serviceHref}>
                      {t.viewService}
                      <Icon name="arrow-right" size={16} />
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )
}
