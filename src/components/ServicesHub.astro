---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import Artwork from './Artwork.astro';
import { ARTWORK_BY_ICON } from '../lib/artwork';
import ServicePlans from './ServicePlans.astro';
import { site, whatsappLink } from '../data/site';
import { serviceHub, services } from '../data/services';
import { listServicePlans } from '../lib/db/queries';

interface Props {
}

const hub = serviceHub;
const homeHref = '/';
const homeLabel = 'Inicio';
const viewLabel = 'Ver servicio';

const plans = await listServicePlans();

const itemList = {
  '@type': 'ItemList',
  '@id': `${new URL(hub.path, site.url).toString()}#services`,
  name: hub.h1,
  itemListElement: services.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: service.content.title,
    description: service.content.cardText,
    url: new URL(service.path, site.url).toString(),
  })),
};
---

<BaseLayout
  title={hub.title}
  description={hub.description}
  path={hub.path}
  ogImage='/assets/og.webp'
  ogImageAlt={`${hub.h1} — ${site.name}`}
  pageType="CollectionPage"
  extraSchema={[itemList]}
  breadcrumb={[
    { name: homeLabel, path: homeHref },
    { name: hub.h1, path: hub.path },
  ]}
>
  <section class="about-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={hub.labels.breadcrumb}>
        <a href={homeHref}>{homeLabel}</a>
        <span aria-hidden="true">/</span>
        <span>{hub.h1}</span>
      </nav>
      <span class="eyebrow">{hub.eyebrow}</span>
      <h1>{hub.h1}</h1>
      <p class="about-intro">{hub.intro}</p>
      <div class="about-hero-actions">
        <a
          class="btn btn-primary"
          href={whatsappLink('Hola Windytech, quiero una cotización.')}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp"
        >
          {hub.cta}
          <Icon name="whatsapp" size={18} />
        </a>
        <a class="btn btn-light" href={`${homeHref}#servicios`}>
          {'Ver en la página principal'}
        </a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="service-grid">
        {services.map((service) => {
          const s = service.content;
          return (
            <article class="card card--art">
              <Artwork theme={ARTWORK_BY_ICON[s.icon] ?? 'software'} height={150} />
              <span class={`icon-badge icon-badge--${s.icon}`}>
                <Icon name={s.icon} size={28} />
              </span>
              <h2>
                <a href={service.path}>{s.title}</a>
              </h2>
              <p>{s.cardText}</p>
              <a class="text-link" href={service.path}>
                {viewLabel}
                <Icon name="arrow-right" size={16} />
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <ServicePlans plans={plans} />

  <section class="cta-band">
    <div class="container cta-inner">
      <div class="cta-copy">
        <h2>{hub.ctaTitle}</h2>
        <p>{hub.ctaText}</p>
      </div>
      <a
        class="btn btn-dark"
        href={whatsappLink('Hola Windytech, necesito ayuda para elegir un servicio.')}
        target="_blank"
        rel="noopener noreferrer"
        data-track="whatsapp"
      >
        {hub.cta}
        <Icon name="whatsapp" size={18} />
      </a>
    </div>
  </section>
</BaseLayout>
