---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareBar from '../ShareBar.astro';
import { site } from '../../data/site';
import { blogPath, type PostSummary } from '../../lib/catalog';
import { imageUrl } from '../../lib/cloudinary';
import { renderMarkdown } from '../../lib/markdown';
import '../../styles/catalog.css';
import '../../styles/detail.css';

interface Props {
  post: PostSummary;
}

const { post } = Astro.props;
const listHref = blogPath();
const href = `${listHref}${post.slug}/`;
const cover = post.coverPublicId
  ? imageUrl(post.coverPublicId, { width: 1600, crop: 'fill', aspectRatio: '16:9', gravity: 'auto' })
  : null;
const published = post.publishedAt ? new Date(post.publishedAt) : null;

const schema = {
  '@type': 'BlogPosting',
  '@id': `${new URL(href, site.url)}#article`,
  headline: post.title,
  description: post.excerpt,
  url: new URL(href, site.url).toString(),
  inLanguage: 'es',
  author: { '@type': 'Person', name: post.author || site.name },
  publisher: { '@id': `${site.url}/#organization` },
  ...(published ? { datePublished: published.toISOString(), dateModified: published.toISOString() } : {}),
  ...(cover ? { image: { '@type': 'ImageObject', url: cover } } : {}),
  ...(post.tags.length > 0 ? { keywords: post.tags.join(', ') } : {}),
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(href, site.url).toString() },
  ...(post.tags.length > 0
    ? {
        about: post.tags.map((tag) => ({ '@type': 'Thing', name: tag })),
      }
    : {}),
};

/** Meta de artículo para que las redes muestren autor y fecha. */
const articleMeta = [
  ...(published ? [{ property: 'article:published_time', content: published.toISOString() }] : []),
  { property: 'article:author', content: post.author || site.name },
  { property: 'article:section', content: 'Blog' },
  ...(cover ? [{ property: 'article:image', content: cover }] : []),
];
---

<BaseLayout
  title={`${post.title} | ${site.name}`}
  description={post.excerpt}
  path={href}
  ogImage={cover ?? '/assets/og.webp'}
  ogImageAlt={post.title}
  ogType="article"
  extraSchema={[schema]}
  extraMeta={articleMeta}
  dateModified={published ? published.toISOString().slice(0, 10) : site.contentUpdated}
  breadcrumb={[
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: listHref },
    { name: post.title, path: href },
  ]}
>
  <article class="section section--white article-page">
    <div class="container article-container">
      <nav class="breadcrumb" aria-label={'Ruta de navegación'}>
        <a href={'/'}>{'Inicio'}</a>
        <span aria-hidden="true">/</span>
        <a href={listHref}>Blog</a>
      </nav>
      <h1>{post.title}</h1>
      <div class="article-meta">
        {published && (
          <time datetime={post.publishedAt ?? ''}>
            {new Intl.DateTimeFormat('es-VE', { dateStyle: 'long' }).format(published)}
          </time>
        )}
        <span>{post.author}</span>
      </div>
      {cover && (
        <img class="article-cover" src={cover} alt={post.title} width="1600" height="900" loading="eager" />
      )}
      <div class="prose" set:html={renderMarkdown(post.bodyMd)} />
      {post.tags.length > 0 && (
        <div class="article-tags">
          {post.tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
      <a class="btn btn-light" href={listHref}>{'Volver al blog'}</a>

      <ShareBar
        path={href}
        title={post.title}
        text={post.excerpt}
        label={'Comparte este artículo y consigue clientes'}
        campaign="post"
        variant="card"
      />
    </div>
  </article>
</BaseLayout>
