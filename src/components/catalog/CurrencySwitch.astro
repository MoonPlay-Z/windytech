---
import type { RateResult } from '../../lib/rate';

interface Props {
  rate: RateResult | null;
}

const { rate } = Astro.props;
---

<div class="currency-switch" role="group" aria-label={'Moneda de exhibición'}>
  <button type="button" data-currency-option="USD" aria-pressed="true">USD</button>
  <button type="button" data-currency-option="VES" disabled={!rate}>Bs</button>
</div>
{rate && (
  <span class="currency-note">
    {'Tasa BCV'}: {rate.rate.toFixed(2)} · {rate.date}
  </span>
)}
