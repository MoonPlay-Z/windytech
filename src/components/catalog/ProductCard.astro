---
import Icon from '../Icon.astro';
import { site, whatsappLink } from '../../data/site';
import {
  availabilityLabels,
  catalogCopy,
  conditionLabels,
  priceFor,
  primaryImage,
  type CatalogProduct,
} from '../../lib/catalog';
import { productImage, productSrcSet } from '../../lib/cloudinary';
import type { RateResult } from '../../lib/rate';

interface Props {
  product: CatalogProduct;
  rate: RateResult | null;
}

const { product, rate } = Astro.props;
const es = true;
const t = catalogCopy;
const price = priceFor(product, null);
const image = primaryImage(product);
// Si Cloudinary no está disponible la URL sale vacía: en ese caso mostramos
// el icono de reserva en lugar de una imagen rota.
const imageSrc = image ? productImage(image.cloudinaryPublicId, 800) : '';
const imageSrcSet = image ? productSrcSet(image.cloudinaryPublicId) : '';
const imageSmall = image ? productImage(image.cloudinaryPublicId, 400) : '';
const href = `${es ? '/catalogo/' : '/en/catalog/'}${product.slug}/`;
const availability = availabilityLabels[product.availability];
const condition = conditionLabels[product.condition];
const compareAt = Math.max(price.compareAtCents, price.listCents);
const vesPrice = rate ? Math.round(price.unitCents * rate.rate) : 0;
const vesCompare = rate ? Math.round(compareAt * rate.rate) : 0;
const consultMessage = es
  ? `Hola Windytech, quiero consultar disponibilidad de ${product.name}.`
  : `Hello Windytech, I would like to check availability of ${product.name}.`;
const addedLabel = es ? 'Añadido' : 'Added';
---

<article class="product-card">
  <a class="product-card-media" href={href} aria-label={product.name}>
    {imageSrc ? (
      <img
        src={imageSrc}
        srcset={imageSrcSet}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        alt={image?.alt || product.name}
        width="800"
        height="600"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="product-card-placeholder" aria-hidden="true">
        <Icon name="monitor" size={40} />
      </span>
    )}
    {price.badge && <span class="product-badge">{price.badge}</span>}
    <span class:list={['product-availability', `is-${product.availability.toLowerCase()}`]}>
      {availability}
    </span>
  </a>

  <div class="product-card-body">
    <div class="product-meta">
      <span>{condition}</span>
      {product.brand && <span>{product.brand}</span>}
    </div>
    <h3><a href={href}>{product.name}</a></h3>
    {product.shortDescription && <p>{product.shortDescription}</p>}

    <div class="product-price">
      {compareAt > price.unitCents && (
        <span class="product-price-old">
          <span data-usd={compareAt} data-ves={vesCompare}>${(compareAt / 100).toFixed(2)}</span>
        </span>
      )}
      <span class="product-price-now" data-usd={price.unitCents} data-ves={vesPrice}>
        ${(price.unitCents / 100).toFixed(2)}
      </span>
    </div>

    <div class="product-card-actions">
      {product.availability === 'OUT_OF_STOCK' ? (
        <a
          class="btn btn-outline btn-sm"
          href={whatsappLink(consultMessage)}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.askAvailability}
        </a>
      ) : (
        <button
          class="btn btn-primary btn-sm"
          type="button"
          data-add-to-cart
          data-id={product.id}
          data-variant=""
          data-slug={product.slug}
          data-name={product.name}
          data-variant-label=""
          data-price={price.unitCents}
          data-availability={product.availability}
          data-image={imageSmall}
          data-added-label={addedLabel}
        >
          <Icon name="shopping-cart" size={16} />
          {t.addToCart}
        </button>
      )}
      <a class="product-card-link" href={href}>
        {t.view}
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
  </div>
</article>
