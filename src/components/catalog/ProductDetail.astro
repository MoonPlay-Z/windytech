---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import ShareBar from '../ShareBar.astro';
import ShareMenu from '../ShareMenu.astro';
import { site, whatsappLink } from '../../data/site';
import {
  attributeLabels,
  availabilityLabels,
  catalogCopy,
  conditionLabels,
  orderProductImages,
  priceFor,
  primaryImage,
  type CatalogProduct,
} from '../../lib/catalog';
import {
  productDetailImage,
  productDetailSrcSet,
  productImage,
  productSrcSet,
  ogImage,
} from '../../lib/cloudinary';
import { renderMarkdown, stripMarkdown } from '../../lib/markdown';
import type { RateResult } from '../../lib/rate';
import { getSocialShareForPage } from '../../lib/social-share';
import '../../styles/catalog.css';
import '../../styles/detail.css';

interface Props {
  product: CatalogProduct;
  rate: RateResult | null;
  currencyDefault: 'USD' | 'VES';
  categoryName?: string;
  altSlug?: string;
  recommendedProducts?: CatalogProduct[];
}

const { product, rate, currencyDefault, categoryName, recommendedProducts = [] } = Astro.props;
const t = catalogCopy;
const basePrice = priceFor(product, null);
const galleryImages = orderProductImages(product.images);
const image = galleryImages[0] ?? null;
const catalogHref = '/catalogo/';
const href = `${catalogHref}${product.slug}/`;
const condition = conditionLabels[product.condition];
const availability = availabilityLabels[product.availability];
const vesPrice = rate ? Math.round(basePrice.unitCents * rate.rate) : 0;
const vesCompare = rate ? Math.round(Math.max(basePrice.compareAtCents, basePrice.listCents) * rate.rate) : 0;
const description = product.seoDescription || product.shortDescription;
const descriptionPreview =
  product.shortDescription?.trim() ||
  stripMarkdown(product.descriptionMd, 220) ||
  product.seoDescription ||
  '';
const specs = Object.entries(product.specs ?? {});
const highlights = specs.slice(0, 6);
const sameCategory =
  product.categoryId === null
    ? []
    : recommendedProducts.filter((item) => item.categoryId === product.categoryId);
const recommendations = (sameCategory.length > 0 ? sameCategory : recommendedProducts).slice(0, 3);
const consultMessage = `Hola Windytech, quiero consultar disponibilidad de ${product.name}.`;

const availabilitySchema =
  product.availability === 'IN_STOCK'
    ? 'https://schema.org/InStock'
    : product.availability === 'PREORDER'
      ? 'https://schema.org/PreOrder'
      : 'https://schema.org/OutOfStock';

/** Meta de producto para que Facebook y WhatsApp muestren precio y stock. */
const productMeta = [
  { property: 'product:price:amount', content: (basePrice.unitCents / 100).toFixed(2) },
  { property: 'product:price:currency', content: 'USD' },
  {
    property: 'product:availability',
    content:
      product.availability === 'IN_STOCK'
        ? 'instock'
        : product.availability === 'PREORDER'
          ? 'preorder'
          : 'outofstock',
  },
  { property: 'product:retailer_item_id', content: product.sku || `WT-${product.id}` },
  { property: 'product:brand', content: product.brand || site.name },
  { property: 'product:condition', content: condition.toLowerCase() },
];

const conditionSchema =
  product.condition === 'NEW'
    ? 'https://schema.org/NewCondition'
    : product.condition === 'REFURBISHED_A'
      ? 'https://schema.org/RefurbishedCondition'
      : 'https://schema.org/UsedCondition';

const imageUrl = image ? ogImage(image.cloudinaryPublicId) : new URL(site.ogImage, site.url).toString();
/** URL de la foto principal; vacía si Cloudinary no responde. */
const mainImageSrc = image ? productDetailImage(image.cloudinaryPublicId, 1200) : '';

/*
 * La tarjeta específica manda. Si no existe, el producto conserva su foto;
 * solo cuando no tiene foto se usa la tarjeta global.
 */
const socialShare = await getSocialShareForPage('product', String(product.id), {
  fallbackToGlobal: !image,
});

const offer = (variant: CatalogProduct['variants'][number] | null) => {
  const price = priceFor(product, variant?.id ?? null);
  const sku = variant?.sku || product.sku || `WT-${product.id}`;
  return {
    '@type': 'Offer',
    sku,
    url: new URL(href, site.url).toString(),
    priceCurrency: 'USD',
    price: (price.unitCents / 100).toFixed(2),
    availability: variant?.availability === 'OUT_OF_STOCK' ? 'https://schema.org/OutOfStock' : availabilitySchema,
    itemCondition: conditionSchema,
    seller: { '@id': `${site.url}/#organization` },
    ...(image ? { image: imageUrl } : {}),
    ...(price.compareAtCents > price.unitCents
      ? {
          priceSpecification: {
            '@type': 'UnitPriceSpecification',
            price: (price.unitCents / 100).toFixed(2),
            priceCurrency: 'USD',
            valueAddedTaxIncluded: false,
          },
        }
      : {}),
  };
};

const productSchema: Record<string, unknown> = {
  '@type': 'ProductGroup',
  '@id': `${new URL(href, site.url)}#product`,
  name: product.name,
  description,
  productGroupID: String(product.id),
  sku: product.sku || `WT-${product.id}`,
  brand: { '@type': 'Brand', name: product.brand || site.name },
  category: categoryName,
  image: image ? [imageUrl] : undefined,
  url: new URL(href, site.url).toString(),
  offers: [offer(null)],
  ...(product.variants.length > 0
    ? {
        variesBy: [
          ...new Set(
            product.variants.flatMap((variant) =>
              Object.keys(variant.attributes ?? {}).map(
                (key) => (attributeLabels as Record<string, string>)[key] ?? key,
              ),
            ),
          ),
        ],
        hasVariant: product.variants.map((variant) => ({
          '@type': 'Product',
          name: `${product.name}${variant.labelEs ? ` — ${variant.labelEs}` : ''}`,
          sku: variant.sku || `${product.sku}-${variant.id}`,
          offers: offer(variant),
        })),
      }
    : {}),
};
---

<BaseLayout
  title={product.seoTitle || `${product.name} | ${site.name}`}
  description={description || t.intro}
  path={href}
  ogImage={imageUrl}
  ogImageAlt={image?.alt || product.name}
  ogType="website"
  socialShare={socialShare}
  currencyDefault={currencyDefault}
  extraSchema={[productSchema]}
  extraMeta={productMeta}
  breadcrumb={[
    { name: 'Inicio', path: '/' },
    { name: t.navLabel, path: catalogHref },
    { name: product.name, path: href },
  ]}
>
  <section class="product-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={'Ruta de navegación'}>
        <a href={'/'}>{'Inicio'}</a>
        <span aria-hidden="true">/</span>
        <a href={catalogHref}>{t.navLabel}</a>
        <span aria-hidden="true">/</span>
        <span>{product.name}</span>
      </nav>

      <div class="product-detail">
        <div
          class:list={['product-gallery', { 'product-gallery--single': galleryImages.length <= 1 }]}
          data-product-gallery
        >
          <div class="product-gallery-main">
            {image && mainImageSrc ? (
              <img
                class="product-gallery-image"
                src={mainImageSrc}
                srcset={productDetailSrcSet(image.cloudinaryPublicId)}
                sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 900px) calc(100vw - 140px), 40vw"
                alt={image.alt || product.name}
                width="1200"
                height="900"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                data-main-image
              />
              <span class="product-gallery-loading" data-gallery-loading aria-hidden="true"></span>
            ) : (
              <span class="product-card-placeholder" aria-hidden="true">
                <Icon name="monitor" size={64} />
              </span>
            )}
          </div>
          <span class="product-gallery-sr-status" role="status" aria-live="polite" data-gallery-status></span>
          {galleryImages.length > 1 && (
            <div class="product-gallery-thumbs">
              {galleryImages.map((item) => (
                <button
                  type="button"
                  class="product-thumb"
                  data-thumb
                  data-full={productDetailImage(item.cloudinaryPublicId, 1200)}
                  data-srcset={productDetailSrcSet(item.cloudinaryPublicId)}
                  aria-pressed={image?.id === item.id ? 'true' : 'false'}
                  aria-label={item.alt || product.name}
                >
                  <img
                    src={productDetailImage(item.cloudinaryPublicId, 200)}
                    alt={item.alt || product.name}
                    width="200"
                    height="150"
                    loading="lazy"
                  />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="product-info">
          <div class="product-meta">
            <span>{condition}</span>
            {product.brand && <span>{product.brand}</span>}
            {product.sku && <span>SKU: {product.sku}</span>}
          </div>

          <h1>{product.name}</h1>
          {product.shortDescription && <p class="product-summary">{product.shortDescription}</p>}

          <div class="product-price product-price--detail">
            <span
              class="product-price-now"
              data-price-now
              data-usd={basePrice.unitCents}
              data-ves={vesPrice}
            >
              ${(basePrice.unitCents / 100).toFixed(2)}
            </span>
            {Math.max(basePrice.compareAtCents, basePrice.listCents) > basePrice.unitCents && (
              <span class="product-price-old" data-price-old data-usd={Math.max(basePrice.compareAtCents, basePrice.listCents)} data-ves={vesCompare}>
                ${(Math.max(basePrice.compareAtCents, basePrice.listCents) / 100).toFixed(2)}
              </span>
            )}
            {Math.max(basePrice.compareAtCents, basePrice.listCents) > basePrice.unitCents && (
              <span class="product-price-savings">
                Ahorras ${((Math.max(basePrice.compareAtCents, basePrice.listCents) - basePrice.unitCents) / 100).toFixed(2)}
              </span>
            )}
          </div>

          <p
            class="product-availability-note"
            data-availability-note
            data-label-in-stock={availabilityLabels.IN_STOCK}
            data-label-preorder={availabilityLabels.PREORDER}
            data-label-out={availabilityLabels.OUT_OF_STOCK}
          >
            <span class:list={['product-availability', `is-${product.availability.toLowerCase()}`]}>
              {availability}
            </span>
          </p>

          {product.variants.length > 0 && (
            <div class="product-variants">
              <h2>{t.variants}</h2>
              <div class="variant-list" data-variant-list>
                {product.variants.map((variant) => {
                  const variantPrice = priceFor(product, variant.id);
                  const label =
                    variant.labelEs ||
                    Object.entries(variant.attributes ?? {})
                      .map(([key, value]) => `${(attributeLabels as Record<string, string>)[key] ?? key}: ${value}`)
                      .join(' · ');
                  return (
                    <button
                      type="button"
                      class="variant-option"
                      data-variant-option
                      data-variant-id={variant.id}
                      data-variant-label={label}
                      data-price={variantPrice.unitCents}
                      data-ves={rate ? Math.round(variantPrice.unitCents * rate.rate) : 0}
                      data-old={Math.max(variantPrice.compareAtCents, variantPrice.listCents)}
                      data-old-ves={rate ? Math.round(Math.max(variantPrice.compareAtCents, variantPrice.listCents) * rate.rate) : 0}
                      data-availability={variant.availability}
                      data-image={variant.imagePublicId ? productDetailImage(variant.imagePublicId, 1200) : image ? productDetailImage(image.cloudinaryPublicId, 1200) : ''}
                      data-image-srcset={variant.imagePublicId ? productDetailSrcSet(variant.imagePublicId) : image ? productDetailSrcSet(image.cloudinaryPublicId) : ''}
                      disabled={variant.availability === 'OUT_OF_STOCK'}
                      aria-pressed="false"
                    >
                      <span class="variant-label">{label}</span>
                      <span class="variant-price" data-usd={variantPrice.unitCents} data-ves={rate ? Math.round(variantPrice.unitCents * rate.rate) : 0}>
                        ${(variantPrice.unitCents / 100).toFixed(2)}
                      </span>
                      {variant.availability === 'OUT_OF_STOCK' && (
                        <span class="variant-out">{t.outOfStock}</span>
                      )}
                      {variant.availability === 'PREORDER' && (
                        <span class="variant-out">{t.preorder}</span>
                      )}
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          <div class="product-actions">
            <ShareMenu
              path={href}
              title={product.name}
              text={product.shortDescription}
              label="Compartir este equipo"
              variant="detail"
              campaign="product"
            />
            {product.availability === 'OUT_OF_STOCK' ? (
              <a
                class="btn btn-primary"
                href={whatsappLink(consultMessage)}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="whatsapp" size={18} />
                {t.askAvailability}
              </a>
            ) : (
              <button
                class="btn btn-primary"
                type="button"
                data-add-to-cart
                data-id={product.id}
                data-variant=""
                data-slug={product.slug}
                data-name={product.name}
                data-variant-label=""
                data-price={basePrice.unitCents}
                data-availability={product.availability}
                data-image={image ? productImage(image.cloudinaryPublicId, 400) : ''}
                data-added-label={'Añadido'}
              >
                <Icon name="shopping-cart" size={18} />
                {t.addToCart}
              </button>
            )}
            <a class="btn btn-light" href={catalogHref}>
              {t.backToCatalog}
            </a>
          </div>

          <p class="product-note">{t.noTax} {t.quoteNotPurchase}</p>

          <ShareBar
            path={href}
            title={product.name}
            text={product.shortDescription || description}
            label={'Comparte este equipo y consigue clientes'}
            campaign="product"
            variant="card"
          />
        </div>
      </div>
    </div>
  </section>

  {highlights.length > 0 && (
    <section class="section section--white product-highlights" aria-labelledby="product-highlights-title">
      <div class="container">
        <div class="product-section-heading">
          <div>
            <span class="product-section-kicker">Ingeniería que impulsa tu trabajo</span>
            <h2 id="product-highlights-title">Lo más importante de {product.model || product.name}</h2>
          </div>
          <span class="product-section-aside">{highlights.length} características destacadas</span>
        </div>
        <div class="product-highlight-grid">
          {highlights.map(([key, value], index) => (
            <article class:list={['product-highlight-card', `product-highlight-card--${index % 4}`]}>
              <span class="product-highlight-mark" aria-hidden="true">{['◇', '↗', '▤', '⌘'][index % 4]}</span>
              <h3>{attributeLabels[key] ?? key}</h3>
              <p>{value}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {specs.length > 0 && (
    <section class="section product-specifications-section" aria-labelledby="product-specifications-title">
      <div class="container">
        <div class="product-specs">
          <div class="product-section-heading">
            <div>
              <span class="product-section-kicker">Auditoría técnica</span>
              <h2 id="product-specifications-title">Especificaciones</h2>
            </div>
            {product.sku && <span class="product-specs-sku">SKU: {product.sku}</span>}
          </div>
          <table class="product-specs__table">
            <tbody>
              {specs.map(([key, value]) => (
                <tr>
                  <th scope="row">{attributeLabels[key] ?? key}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {product.descriptionMd && (
    <section class="section section--white">
      <div class="container product-description">
        <details class="product-description-disclosure">
          <summary>
            <span class="product-section-kicker">Detalles del equipo</span>
            <span class="product-description-title">{t.description}</span>
            {descriptionPreview && (
              <span class="product-description-preview">{descriptionPreview}</span>
            )}
            <span class="product-description-more">
              <span class="product-description-more-label">Ver más</span>
              <span class="product-description-less-label">Ver menos</span>
            </span>
          </summary>
          <div class="prose product-description-full" set:html={renderMarkdown(product.descriptionMd)} />
        </details>
      </div>
    </section>
  )}

  {recommendations.length > 0 && (
    <section class="section product-recommendations" aria-labelledby="product-recommendations-title">
      <div class="container">
        <div class="product-section-heading">
          <div>
            <span class="product-section-kicker">Ecosistema profesional</span>
            <h2 id="product-recommendations-title">También te puede interesar</h2>
          </div>
          <a class="product-more-link" href={catalogHref}>Ver catálogo completo <span aria-hidden="true">→</span></a>
        </div>
        <div class="product-recommendation-grid">
          {recommendations.map((item) => {
            const itemImage = primaryImage(item);
            const itemPrice = priceFor(item, null);
            const itemHref = `${catalogHref}${item.slug}/`;
            return (
              <a class="product-recommendation-card" href={itemHref}>
                <span class="product-recommendation-media">
                  {itemImage ? (
                    <img
                      src={productImage(itemImage.cloudinaryPublicId, 600)}
                      srcset={productSrcSet(itemImage.cloudinaryPublicId)}
                      sizes="(max-width: 720px) 100vw, 33vw"
                      alt={itemImage.alt || item.name}
                      width="600"
                      height="450"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="product-recommendation-placeholder" aria-hidden="true">◇</span>
                  )}
                </span>
                <span class="product-recommendation-copy">
                  <small>{item.brand || conditionLabels[item.condition]}</small>
                  <strong>{item.name}</strong>
                  <span>${(itemPrice.unitCents / 100).toFixed(2)}</span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="section section--white product-faq" aria-labelledby="product-faq-title">
    <div class="container">
      <div class="product-faq-panel">
        <span class="product-section-kicker">Ayuda para tu compra</span>
        <h2 id="product-faq-title">Preguntas frecuentes</h2>
        <p>Resuelve tus dudas sobre este equipo antes de realizar tu pedido.</p>
        <div class="product-faq-list">
          <details>
            <summary>¿Cómo elijo una configuración?</summary>
            <p>
              {product.variants.length > 0
                ? 'Revisa las opciones disponibles en la ficha. Al seleccionar una configuración se actualizan el precio y, cuando corresponda, la imagen.'
                : 'La ficha muestra la configuración disponible para este equipo. Escríbenos si necesitas validar otra opción.'}
            </p>
          </details>
          <details>
            <summary>¿Cómo confirmo disponibilidad y entrega?</summary>
            <p>
              La disponibilidad mostrada corresponde al estado registrado del producto. Para coordinar entrega o confirmar detalles,
              <a href={whatsappLink(consultMessage)} target="_blank" rel="noopener noreferrer"> contáctanos por WhatsApp</a>.
            </p>
          </details>
          <details>
            <summary>¿Cómo realizo mi pedido?</summary>
            <p>
              Añade el equipo al carrito para revisar tu pedido y continuar con la solicitud. También puedes
              <a href={whatsappLink(consultMessage)} target="_blank" rel="noopener noreferrer"> consultarnos directamente</a>.
            </p>
          </details>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/cart';

  function initProductDetail() {
    const priceNode = document.querySelector<HTMLElement>('[data-price-now]');
    const oldNode = document.querySelector<HTMLElement>('[data-price-old]');
    const availabilityNote = document.querySelector<HTMLElement>('[data-availability-note]');
    const addButton = document.querySelector<HTMLButtonElement>('[data-add-to-cart]');
    const mainImage = document.querySelector<HTMLImageElement>('[data-main-image]');
    const galleryLoading = document.querySelector<HTMLElement>('[data-gallery-loading]');
    const galleryStatus = document.querySelector<HTMLElement>('[data-gallery-status]');
    const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
    let activeImage = mainImage?.currentSrc || mainImage?.src || '';
    let loadToken = 0;

    // Estado de carga de la imagen inicial (LCP).
    if (mainImage) {
      if (mainImage.complete && mainImage.naturalWidth > 0) {
        galleryLoading?.setAttribute('hidden', '');
      } else {
        mainImage.classList.add('is-loading');
        mainImage.addEventListener('load', () => {
          mainImage.classList.remove('is-loading');
          mainImage.classList.add('is-ready');
          galleryLoading?.setAttribute('hidden', '');
        }, { once: true });
        mainImage.addEventListener('error', () => {
          mainImage.classList.remove('is-loading');
          galleryLoading?.setAttribute('hidden', '');
          if (galleryStatus) galleryStatus.textContent = 'No se pudo cargar la imagen del producto.';
        }, { once: true });
      }
    }

    /** Cambia la imagen principal con precarga, estado de carga y transición suave. */
    const setMainImage = (full: string, srcset: string, alt: string) => {
      if (!mainImage || !full || full === activeImage) return;
      const token = ++loadToken;
      galleryLoading?.removeAttribute('hidden');
      mainImage.classList.add('is-loading');

      const preload = new Image();
      preload.decoding = 'async';
      preload.sizes = mainImage.sizes;
      if (srcset) preload.srcset = srcset;
      preload.onload = () => {
        if (token !== loadToken) return;
        mainImage.src = full;
        if (srcset) mainImage.srcset = srcset;
        mainImage.alt = alt;
        activeImage = full;
        mainImage.classList.remove('is-loading');
        mainImage.classList.add('is-ready');
        galleryLoading?.setAttribute('hidden', '');
        if (galleryStatus) galleryStatus.textContent = 'Imagen actualizada.';
      };
      preload.onerror = () => {
        if (token !== loadToken) return;
        mainImage.classList.remove('is-loading');
        galleryLoading?.setAttribute('hidden', '');
        if (galleryStatus) galleryStatus.textContent = 'No se pudo cargar la imagen. Prueba otra.';
      };
      preload.src = full;
      // Si ya estaba en caché, onload puede no dispararse.
      if (preload.complete && preload.naturalWidth > 0) preload.onload(new Event('load'));
    };

    // Precarga de las primeras miniaturas para que el cambio sea instantáneo.
    window.setTimeout(() => {
      for (const thumb of thumbs.slice(0, 4)) {
        const url = thumb.dataset.full;
        if (url && url !== activeImage) {
          const img = new Image();
          img.src = url;
        }
      }
    }, 900);

    document.querySelectorAll<HTMLButtonElement>('[data-variant-option]').forEach((option) => {
      if (option.dataset.wtBound === 'true') return;
      option.dataset.wtBound = 'true';

      option.addEventListener('click', () => {
        document.querySelectorAll('[data-variant-option]').forEach((entry) => {
          entry.setAttribute('aria-pressed', String(entry === option));
          entry.classList.toggle('is-selected', entry === option);
        });

        const price = Number(option.dataset.price ?? '0');
        const ves = Number(option.dataset.ves ?? '0');
        const old = Number(option.dataset.old ?? '0');
        const oldVes = Number(option.dataset.oldVes ?? '0');

        if (priceNode) {
          priceNode.dataset.usd = String(price);
          priceNode.dataset.ves = String(ves);
        }
        if (oldNode) {
          oldNode.dataset.usd = String(old);
          oldNode.dataset.ves = String(oldVes);
          oldNode.hidden = old <= price;
        }
        if (availabilityNote) {
          const availability = option.dataset.availability ?? 'IN_STOCK';
          const label =
            availability === 'IN_STOCK'
              ? availabilityNote.dataset.labelInStock
              : availability === 'PREORDER'
                ? availabilityNote.dataset.labelPreorder
                : availabilityNote.dataset.labelOut;
          availabilityNote.innerHTML = `<span class="product-availability is-${availability.toLowerCase()}">${label}</span>`;
        }
        if (addButton) {
          addButton.dataset.variant = option.dataset.variantId ?? '';
          addButton.dataset.variantLabel = option.dataset.variantLabel ?? '';
          addButton.dataset.price = String(price);
          addButton.dataset.availability = option.dataset.availability ?? 'IN_STOCK';
          addButton.disabled = option.dataset.availability === 'OUT_OF_STOCK';
        }

        const image = option.dataset.image;
        if (image) {
          setMainImage(image, option.dataset.imageSrcset ?? '', mainImage?.alt ?? '');
        }
        window.dispatchEvent(new CustomEvent('wt:prices-updated'));
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((thumb) => {
      if (thumb.dataset.wtBound === 'true') return;
      thumb.dataset.wtBound = 'true';

      thumb.addEventListener('click', () => {
        setMainImage(
          thumb.dataset.full ?? '',
          thumb.dataset.srcset ?? '',
          thumb.getAttribute('aria-label') || mainImage?.alt || '',
        );
        if (mainImage) {
          document.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((item) => {
            item.setAttribute('aria-pressed', String(item === thumb));
          });
        }
      });
    });
  }

  initProductDetail();
  document.addEventListener('astro:page-load', initProductDetail);
</script>
