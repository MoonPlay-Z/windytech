---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareBar from '../ShareBar.astro';
import { site, whatsappLink } from '../../data/site';
import { projectsPath, type ProjectSummary } from '../../lib/catalog';
import { projectImage } from '../../lib/cloudinary';
import { renderMarkdown } from '../../lib/markdown';
import '../../styles/catalog.css';
import '../../styles/detail.css';

interface Props {
  project: ProjectSummary;
}

const { project } = Astro.props;
const listHref = projectsPath();
const href = `${listHref}${project.slug}/`;
const cover = project.coverPublicId ? projectImage(project.coverPublicId, 1600) : null;

/*
 * El título se recorta para no pasar de 60 caracteres: si no, Google lo
 * corta con puntos suspensivos en el resultado y se pierde la marca.
 */
const titulo = (() => {
  const completo = `${project.title} | ${site.name}`;
  if (completo.length <= 60) return completo;
  const base = project.title.slice(0, 60 - site.name.length - 3).trim();
  return `${base}… | ${site.name}`;
})();

const schema = {
  '@type': 'CreativeWork',
  '@id': `${new URL(href, site.url)}#project`,
  name: project.title,
  description: project.summary,
  url: new URL(href, site.url).toString(),
  creator: { '@id': `${site.url}/#organization` },
  dateCreated: project.year ? String(project.year) : undefined,
  ...(cover ? { image: { '@type': 'ImageObject', url: cover } } : {}),
  ...(project.clientName ? { sourceOrganization: { '@type': 'Organization', name: project.clientName } } : {}),
};
---

<BaseLayout
  title={titulo}
  description={project.summary}
  path={href}
  ogImage={cover ?? '/assets/og.webp'}
  ogImageAlt={project.title}
  ogType="article"
  extraSchema={[schema]}
  breadcrumb={[
    { name: 'Inicio', path: '/' },
    { name: 'Proyectos', path: listHref },
    { name: project.title, path: href },
  ]}
>
  <section class="about-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={'Ruta de navegación'}>
        <a href={'/'}>{'Inicio'}</a>
        <span aria-hidden="true">/</span>
        <a href={listHref}>{'Proyectos'}</a>
      </nav>
      <span class="eyebrow">{project.year ?? ('PROYECTO')}</span>
      <h1>{project.title}</h1>
      <p class="about-intro">{project.summary}</p>
      <div class="product-meta">
        {project.services.map((service) => <span>{service}</span>)}
        {project.clientName && <span>{project.clientName}</span>}
      </div>
    </div>
  </section>

  {cover && (
    <div class="container">
      <img
        class="project-cover"
        src={cover}
        alt={project.title}
        width="1600"
        height="900"
        loading="eager"
      />
    </div>
  )}

  <section class="section section--white">
    <div class="container product-description">
      <div class="prose" set:html={renderMarkdown(project.descriptionMd)} />
      {project.images && project.images.length > 0 && (
        <div class="project-gallery">
          {project.images.map((image) => (
            <img
              src={projectImage(image.cloudinaryPublicId, 800)}
              alt={image.alt || project.title}
              width="800"
              height="450"
              loading="lazy"
            />
          ))}
        </div>
      )}
      <div class="quote-actions">
        <a
          class="btn btn-primary"
          href={whatsappLink('Hola Windytech, quiero un proyecto como este.')}
          target="_blank"
          rel="noopener noreferrer"
        >
          {'Quiero un proyecto así'}
        </a>
        <a class="btn btn-light" href={listHref}>{'Ver todos los proyectos'}</a>
      </div>

      <ShareBar
        path={href}
        title={project.title}
        text={project.summary}
        label={'Comparte este proyecto y consigue clientes'}
        campaign="project"
        variant="card"
      />
    </div>
  </section>
</BaseLayout>
