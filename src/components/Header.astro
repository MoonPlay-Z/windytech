---
import Icon from './Icon.astro';
import { content, site, whatsappLink, type Lang } from '../data/site';
import type { CustomerSession } from '../lib/customer-auth';

interface Props {
  lang: Lang;
  altHref: string;
  customer?: CustomerSession | null;
}

const { lang, altHref, customer } = Astro.props;
const t = content[lang];
const homeHref = lang === 'es' ? '/' : '/en/';
const navAria = lang === 'es' ? 'Navegación principal' : 'Main navigation';
const markAlt = lang === 'es'
    ? 'Windytech — desarrollo de software y automatización'
    : 'Windytech — software development and automation';
const isLoggedIn = Boolean(customer);
---

<div class="campaign-bar">
  <div class="container campaign-inner">
    <span class="campaign-label">{t.campaignBar.label}</span>
    <span>{t.campaignBar.text}</span>
    <a href={`${homeHref}#campanas`}>{t.campaignBar.link}</a>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label={`${site.name} — ${t.nav.home}`}>
      <img
        class="brand-mark"
        src="/assets/logo-mark-96.webp"
        alt={markAlt}
        width="96"
        height="96"
        loading="eager"
      />
      <img
        class="brand-wordmark"
        src="/assets/logo-wordmark-346.webp"
        alt={markAlt}
        width="300"
        height="68"
        loading="eager"
      />
    </a>

    <nav class="nav" id="primary-nav" data-nav aria-label={navAria}>
      {t.nav.items.map((item) => (
        <a href={item.href.startsWith('/') ? item.href : `${homeHref}${item.href}`}>{item.label}</a>
      ))}
      <div class="nav-account">
        {isLoggedIn && customer ? (
          <>
            <a href="/cuenta/perfil/">Mi perfil</a>
            <a href="/cuenta/editar-perfil/">Modificar perfil</a>
            <button type="button" class="nav-account-logout" data-logout-button>
              Cerrar sesión
            </button>
          </>
        ) : (
          <>
            <a href="/cuenta/login/">Iniciar sesión</a>
            <a href="/cuenta/registro/">Registrarse</a>
          </>
        )}
      </div>
      <a
        class="btn btn-primary nav-cta"
        href={whatsappLink(t.whatsapp.general)}
        target="_blank"
        rel="noopener noreferrer"
        data-track="whatsapp"
      >
        {t.nav.cta}
        <Icon name="whatsapp" size={18} />
      </a>
    </nav>

    <div class="header-actions">
      {isLoggedIn && customer ? (
        <>
          <div class="profile-menu" data-profile-menu>
            <button
              type="button"
              class="btn btn-sm btn-outline profile-trigger"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-label={`Menú de cuenta de ${customer.name}`}
              data-profile-toggle
            >
              <span class="profile-name">{customer.name}</span>
              <Icon name="chevron-down" size={14} />
            </button>
            <div class="profile-dropdown" data-profile-dropdown hidden>
              <a class="dropdown-item" href="/cuenta/perfil/" data-profile-close>
                <Icon name="user" size={14} />
                <span>Mi perfil</span>
              </a>
              <a class="dropdown-item" href="/cuenta/editar-perfil/" data-profile-close>
                <Icon name="edit" size={14} />
                <span>Modificar perfil</span>
              </a>
              <a class="dropdown-item" href="/cuenta/cambiar-contrasena/" data-profile-close>
                <Icon name="lock" size={14} />
                <span>Cambiar contraseña</span>
              </a>
              <hr class="dropdown-divider" />
              <button
                class="dropdown-item dropdown-item--danger"
                type="button"
                data-logout-button
              >
                <Icon name="log-out" size={14} />
                <span>Salir</span>
              </button>
            </div>
          </div>
        </>
      ) : (
        <>
          <a
            class="btn btn-sm btn-outline header-account"
            href="/cuenta/login/"
            aria-label="Iniciar sesión"
          >
            Iniciar sesión
          </a>
          <a
            class="btn btn-sm btn-outline ml-2 header-account"
            href="/cuenta/registro/"
            aria-label="Registrarse"
          >
            Registrarse
          </a>
        </>
      )}
      <a
        class="cart-link"
        href={lang === 'es' ? '/carrito/' : '/en/cart/'}
        aria-label={lang === 'es' ? 'Ver carrito' : 'View cart'}
      >
        <Icon name="shopping-cart" size={20} />
        <span class="cart-count" data-cart-count hidden>0</span>
      </a>
      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        data-open-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
        data-close-label={lang === 'es' ? 'Cerrar menú' : 'Close menu'}
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
      >
        <span class="menu-box" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  let cleanupHeader: (() => void) | null = null;

  function initHeader() {
    cleanupHeader?.();
    cleanupHeader = null;
    document.body.classList.remove('nav-open');

    const controller = new AbortController();
    const { signal } = controller;
    cleanupHeader = () => controller.abort();

    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');

    if (toggle && nav) {
      const setOpen = (open: boolean) => {
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? toggle.dataset.closeLabel ?? 'Cerrar menú' : toggle.dataset.openLabel ?? 'Abrir menú');
        nav.dataset.open = String(open);
        document.body.classList.toggle('nav-open', open);
      };

      toggle.addEventListener('click', () => {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      }, { signal });

      nav.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false), { signal });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setOpen(false);
      }, { signal });
    }

    /* --- Menú de perfil desplegable --- */
    const profileToggle = document.querySelector<HTMLButtonElement>('[data-profile-toggle]');
    const profileMenu = document.querySelector<HTMLElement>('[data-profile-menu]');
    const profileDropdown = document.querySelector<HTMLElement>('[data-profile-dropdown]');

    if (profileToggle && profileMenu && profileDropdown) {
      const closeDropdown = () => {
        profileToggle.setAttribute('aria-expanded', 'false');
        profileDropdown.hidden = true;
        profileMenu.removeAttribute('data-open');
      };

      profileToggle.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = profileToggle.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeDropdown();
        } else {
          profileToggle.setAttribute('aria-expanded', 'true');
          profileDropdown.hidden = false;
          profileMenu.setAttribute('data-open', 'true');
        }
      }, { signal });

      // Cerrar al hacer clic en cualquier opción del menú
      profileDropdown.querySelectorAll('[data-profile-close]').forEach((link) => {
        link.addEventListener('click', () => closeDropdown(), { signal });
      });

      // Cerrar al hacer clic fuera
      document.addEventListener('click', (event) => {
        if (!profileMenu.contains(event.target as Node)) {
          closeDropdown();
        }
      }, { signal });

      // Cerrar con Escape
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeDropdown();
      }, { signal });
    }

    /* --- Cerrar sesión (menú de perfil y botón de la página de cuenta) --- */
    const logoutButtons = document.querySelectorAll<HTMLButtonElement>('[data-logout-button]');
    logoutButtons.forEach((button) => {
      button.addEventListener('click', async () => {
        logoutButtons.forEach((item) => (item.disabled = true));
        try {
          const response = await fetch('/api/auth/logout', {
            method: 'POST',
            credentials: 'same-origin',
          });
          const data = (await response.json().catch(() => null)) as { error?: string } | null;
          if (!response.ok) {
            throw new Error(data?.error || `No se pudo cerrar la sesión (${response.status}).`);
          }
          window.location.assign('/cuenta/login/');
        } catch (error) {
          logoutButtons.forEach((item) => (item.disabled = false));
          alert(error instanceof Error ? error.message : 'No se pudo cerrar la sesión.');
        }
      }, { signal });
    });
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
