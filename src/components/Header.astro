---
import Icon from './Icon.astro';
import { content, site, whatsappLink, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  altHref: string;
}

const { lang, altHref } = Astro.props;
const t = content[lang];
const homeHref = lang === 'es' ? '/' : '/en/';
const navAria = lang === 'es' ? 'Navegación principal' : 'Main navigation';
const menuLabel = t.nav.menu;
const markAlt = lang === 'es' ? 'Símbolo de Windy Tech' : 'Windy Tech symbol';
const wordmarkAlt =
  lang === 'es'
    ? 'Windy Tech — desarrollo de software y automatización'
    : 'Windy Tech — software development and automation';
---

<div class="campaign-bar">
  <div class="container campaign-inner">
    <span class="campaign-label">{t.campaignBar.label}</span>
    <span>{t.campaignBar.text}</span>
    <a href={`${homeHref}#campanas`}>{t.campaignBar.link}</a>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label={`${site.name} — ${t.nav.home}`}>
      <img
        class="brand-mark"
        src="/assets/logo-mark-96.webp"
        alt={markAlt}
        width="96"
        height="96"
        loading="eager"
      />
      <img
        class="brand-wordmark"
        src="/assets/logo-wordmark-346.webp"
        alt={wordmarkAlt}
        width="346"
        height="48"
        loading="eager"
      />
    </a>

    <nav class="nav" id="primary-nav" data-nav aria-label={navAria}>
      {t.nav.items.map((item) => <a href={`${homeHref}${item.href}`}>{item.label}</a>)}
      <a
        class="btn btn-primary nav-cta"
        href={whatsappLink(t.whatsapp.general)}
        target="_blank"
        rel="noopener noreferrer"
        data-track="whatsapp"
      >
        {t.nav.cta}
        <Icon name="whatsapp" size={18} />
      </a>
    </nav>

    <div class="header-actions">
      <a class="lang-switch" href={altHref} aria-label={t.nav.switchLang}>
        {t.nav.switchLangShort}
      </a>
      <a
        class="btn btn-primary header-cta"
        href={whatsappLink(t.whatsapp.general)}
        target="_blank"
        rel="noopener noreferrer"
        data-track="whatsapp"
      >
        {t.nav.headerCta}
        <Icon name="whatsapp" size={18} />
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        aria-label={menuLabel}
        data-menu-toggle
        data-open-label={t.nav.menu}
        data-close-label={t.nav.closeMenu}
      >
        <span class="menu-box" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? toggle.dataset.closeLabel ?? 'Cerrar menú' : toggle.dataset.openLabel ?? 'Abrir menú');
      nav.dataset.open = String(open);
      document.body.classList.toggle('nav-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
