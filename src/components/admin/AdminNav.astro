---
interface Props {
  active: string;
  role: 'OWNER' | 'EDITOR';
}

const { active, role } = Astro.props;
const isOwner = role === 'OWNER';

const baseLinks = [
  { key: 'dashboard', label: 'Resumen', href: '/admin/' },
  { key: 'profile', label: 'Perfil', href: '/admin/perfil/' },
  { key: 'services', label: 'Paquetes', href: '/admin/servicios/' },
  { key: 'products', label: 'Productos', href: '/admin/productos/' },
  { key: 'categories', label: 'Categorías', href: '/admin/categorias/' },
  { key: 'promotions', label: 'Promociones', href: '/admin/promociones/' },
  { key: 'quotes', label: 'Cotizaciones', href: '/admin/cotizaciones/' },
  { key: 'leads', label: 'Consultas', href: '/admin/leads/' },
  { key: 'trackings', label: 'Seguimientos', href: '/admin/seguimientos/' },
  { key: 'projects', label: 'Proyectos', href: '/admin/proyectos/' },
  { key: 'posts', label: 'Publicaciones', href: '/admin/publicaciones/' },
];

const links = isOwner
  ? [...baseLinks, { key: 'users', label: 'Usuarios', href: '/admin/usuarios/' }]
  : baseLinks;
---

<nav class="admin-nav" aria-label="Navegación del panel">
  {links.map((link) => (
    <a
      href={link.href}
      class:list={['admin-nav-link', { 'is-active': active === link.key }]}
      aria-current={active === link.key ? 'page' : undefined}
    >
      {link.label}
    </a>
  ))}
</nav>
