---
/**
 * Menú contextual de una fila: se abre con el botón de la derecha.
 *
 * El menú se escribe en el HTML y el script `admin-context.ts` lo coloca y
 * lo cierra. Se usa así para que los iconos salgan del registro central.
 */

import Icon from '../Icon.astro';

interface Props {
  /** Identificador del menú. */
  id: string;
  /**
   * Acciones: texto, enlace y opcionalmente un icono.
   * Si se indica `deleteEndpoint`, la acción se comporta como un borrado
   * (pide confirmación y llama a la API).
   */
  actions: {
    label: string;
    href: string;
    icon?: string;
    danger?: boolean;
    deleteEndpoint?: string;
    confirm?: string;
  }[];
  /** Texto del botón que abre el menú (para lectores de pantalla). */
  label?: string;
}

const { id, actions, label = 'Más acciones' } = Astro.props;
---

<div class="win-menu win-context-menu" id={id} role="menu" hidden>
  {
    actions.map((accion) => (
      <a
        href={accion.href}
        role="menuitem"
        data-peligro={accion.danger ? 'true' : undefined}
        data-delete={accion.deleteEndpoint}
        data-confirm={accion.confirm}
      >
        {accion.icon && <Icon name={accion.icon} size={15} />}
        <span>{accion.label}</span>
      </a>
    ))
  }
</div>
