---
import '../../styles/global.css';
import '../../styles/admin.css';
import { ClientRouter } from 'astro:transitions';
import type { AdminSession } from '../../lib/auth';
import AdminNav from './AdminNav.astro';
import { site } from '../../data/site';

interface Props {
  title: string;
  admin: AdminSession;
  active: string;
}

const { title, admin, active } = Astro.props;
---

<!doctype html>
<html lang="es" class="admin-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Panel Windytech</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preload" href="/assets/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/outfit-latin.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body class="admin-body">
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <a class="admin-brand" href="/admin/">
          <img src="/assets/logo-mark-96.webp" alt="" width="40" height="40" />
          <span>Windytech<small>Panel</small></span>
        </a>
        <AdminNav active={active} role={admin.role} />
        <div class="admin-sidebar-footer">
          <span>{admin.email}</span>
          <span class="admin-role">{admin.role}</span>
          <a href="/admin/perfil/" class="admin-btn admin-btn--ghost" style="font-size:12px">Mi perfil</a>
          <button type="button" class="admin-btn admin-btn--ghost" data-logout>Cerrar sesión</button>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <div class="admin-topbar-title">
            <span class="admin-overline">WINDYTECH / ADMINISTRACIÓN</span>
            <h1>{title}</h1>
          </div>
          <div class="admin-topbar-actions">
            <span class="admin-online"><span></span> Sesión segura</span>
            <a class="admin-btn admin-btn--ghost" href={site.url} target="_blank" rel="noopener">
              Ver sitio <span aria-hidden="true">↗</span>
            </a>
          </div>
        </header>
        <slot />
      </div>
    </div>
    <script>
      import '../../scripts/admin';
    </script>
  </body>
</html>
