---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import Artwork from './Artwork.astro';
import { ARTWORK_BY_ICON } from '../lib/artwork';
import PlanCard from './PlanCard.astro';
import ShareBar from './ShareBar.astro';
import { site, whatsappLink } from '../data/site';
import { servicePath, services, type Service } from '../data/services';
import { listServicePlans } from '../lib/db/queries';

interface Props {
  service: Service;
  path: string;
}

const { service, path } = Astro.props;
const s = service.content;
const homeHref = '/';
const hubHref = '/servicios/';
const homeLabel = 'Inicio';
const hubLabel = 'Servicios';
const labels = {
  breadcrumb: 'Ruta de navegación',
  related: 'Otros servicios',
  cta: 'Pedir cotización',
  back: 'Ver todos los servicios',
  plansTitle: 'Paquetes de este servicio',
  plansIntro:
    'Elige el paquete que se ajusta a tu momento: verás qué incluye, cuánto cuesta y en cuánto tiempo se aplica.',
  shareLabel: 'Comparte este servicio y consigue clientes',
};

const canonical = new URL(path, site.url).toString();
const related = s.related
  .map((slug) => services.find((item) => item.content.slug === slug))
  .filter((item): item is Service => Boolean(item));

const plans = await listServicePlans(service.id);

/*
 * Precio de entrada del servicio: el paquete más barato que lo incluye.
 * Se muestra en la barra lateral porque "cuánto cuesta" es una de las
 * búsquedas más comunes y el buscador favorece los datos de precio.
 */
const precioDesde = (() => {
  const masBarato = [...plans].sort((a, b) => a.priceCents - b.priceCents)[0];
  if (!masBarato) return null;
  return {
    priceCents: masBarato.priceCents,
    nota: masBarato.deliveryTime
      ? `${masBarato.name} · ${masBarato.deliveryTime}`
      : masBarato.name,
  };
})();

const serviceSchema = {
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: s.title,
  description: s.metaDescription,
  serviceType: s.title,
  url: canonical,
  provider: { '@id': `${site.url}/#organization` },
  areaServed:
    service.id === 'networks' || service.id === 'equipment'
      ? [{ '@type': 'Country', name: site.address.countryName }]
      : [
          { '@type': 'Country', name: site.address.countryName },
          { '@type': 'Place', name: 'Worldwide' },
        ],
  availableLanguage: ['Spanish', 'English'],
  // Precio de entrada: el buscador lo muestra como "desde $X" en el resumen.
  ...(precioDesde
    ? {
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: 'USD',
          lowPrice: (precioDesde.priceCents / 100).toFixed(2),
          offerCount: plans.length,
        },
      }
    : {}),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: s.includesTitle,
    itemListElement: s.includes.map((item, index) => ({
      '@type': 'Offer',
      position: index + 1,
      itemOffered: {
        '@type': 'Service',
        name: item.title,
        description: item.text,
      },
    })),
  },
  ...(plans.length > 0
    ? {
        makesOffer: plans.map((plan) => ({
          '@type': 'Offer',
          name: plan.name,
          description: plan.tagline,
          url: canonical,
          priceCurrency: plan.currency,
          price: (plan.priceCents / 100).toFixed(2),
          ...(plan.billingPeriod === 'monthly'
            ? { priceSpecification: { '@type': 'UnitPriceSpecification', price: (plan.priceCents / 100).toFixed(2), priceCurrency: plan.currency, unitText: 'MONTH' } }
            : {}),
          itemOffered: {
            '@type': 'Service',
            name: plan.name,
            description: plan.tagline,
            ...(plan.deliveryTime
              ? {
                  deliveryTime: plan.deliveryTime,
                  ...(plan.includes.length > 0
                    ? {
                        hasPart: plan.includes.map((item) => ({
                          '@type': 'Service',
                          name: item,
                        })),
                      }
                    : {}),
                }
              : {}),
          },
        })),
      }
    : {}),
};
---

<BaseLayout
  title={s.metaTitle}
  description={s.metaDescription}
  path={path}
  ogImage='/assets/og.webp'
  ogImageAlt={`${s.title} — ${site.name}`}
  pageType="WebPage"
  dateModified={site.contentUpdated}
  faq={s.faqs}
  extraSchema={[serviceSchema]}
  breadcrumb={[
    { name: homeLabel, path: homeHref },
    { name: hubLabel, path: hubHref },
    { name: s.title, path },
  ]}
>
  <section class="about-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={labels.breadcrumb}>
        <a href={homeHref}>{homeLabel}</a>
        <span aria-hidden="true">/</span>
        <a href={hubHref}>{hubLabel}</a>
        <span aria-hidden="true">/</span>
        <span>{s.title}</span>
      </nav>
      <div class="service-hero-art">
        <Artwork theme={ARTWORK_BY_ICON[s.icon] ?? 'software'} height={190} />
      </div>
      <span class="eyebrow">{s.eyebrow}</span>
      <h1>{s.title}</h1>
      <p class="about-intro">{s.intro}</p>
      <div class="about-hero-actions">
        <a
          class="btn btn-primary"
          href={whatsappLink(s.message)}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp"
        >
          {labels.cta}
          <Icon name="whatsapp" size={18} />
        </a>
        <a class="btn btn-light" href={hubHref}>{labels.back}</a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container about-page-grid">
      <article class="about-page-main">
        <h2>{s.includesTitle}</h2>
        <ul class="about-service-list">
          {s.includes.map((item) => (
            <li>
              <Icon name="check" size={20} />
              <span>
                <strong>{item.title}</strong>
                {item.text}
              </span>
            </li>
          ))}
        </ul>

        <h2>{s.processTitle}</h2>
        <ol class="about-steps">
          {s.process.map((step, index) => (
            <li>
              <span class="about-step-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>
                <strong>{step.title}</strong>
                {step.text}
              </span>
            </li>
          ))}
        </ol>

        <h2>{s.useCasesTitle}</h2>
        <ul class="about-service-list">
          {s.useCases.map((useCase) => (
            <li>
              <Icon name="check-simple" size={20} />
              <span>{useCase}</span>
            </li>
          ))}
        </ul>

        <h2>{s.pricingTitle}</h2>
        <ul>
          {s.pricing.map((paragraph) => <li>{paragraph}</li>)}
        </ul>
      </article>

      <aside class="about-page-aside">
        {precioDesde && (
          <div class="about-facts-card about-price-card">
            <p class="eyebrow">Precio desde</p>
            <p class="about-price-value">
              ${precioDesde.priceCents / 100}
              <span>USD</span>
            </p>
            <p class="about-price-note">{precioDesde.nota}</p>
          </div>
        )}

        <div class="about-facts-card">
          <h2>{s.title}</h2>
          <dl class="about-page-facts">
            {s.quickFacts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="about-contact-card">
          <h2>{s.ctaTitle}</h2>
          <p>{s.ctaText}</p>
          <a
            class="btn btn-primary"
            href={whatsappLink(s.message)}
            target="_blank"
            rel="noopener noreferrer"
            data-track="whatsapp"
          >
            {labels.cta}
            <Icon name="whatsapp" size={18} />
          </a>
        </div>

        {related.length > 0 && (
          <div class="about-facts-card">
            <h2>{labels.related}</h2>
            <ul class="service-related">
              {related.map((item) => (
                <li>
                  <a href={servicePath(item)}>
                    {item.content.title}
                    <Icon name="arrow-right" size={16} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  {
    plans.length > 0 && (
      <section class="section section--white" id="paquetes">
        <div class="container">
          <div class="plans-head">
            <span class="eyebrow">{'PAQUETES'}</span>
            <h2>{labels.plansTitle}</h2>
            <p>{labels.plansIntro}</p>
          </div>
          <div class="plan-grid">
            {plans.map((plan) => (
              <PlanCard
                plan={plan}
                shareUrl={new URL(`${path}#plan-${plan.slug}`, site.url).toString()}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--soft" id="preguntas">    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{s.eyebrow}</span>
        <h2>{s.faqTitle}</h2>
        <p>{s.metaDescription}</p>
      </div>
      <div class="faq-list">
        {s.faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <div class="cta-copy">
        <h2>{s.ctaTitle}</h2>
        <p>{s.ctaText}</p>
      </div>
      <a
        class="btn btn-dark"
        href={whatsappLink(s.message)}
        target="_blank"
        rel="noopener noreferrer"
        data-track="whatsapp"
      >
        {labels.cta}
        <Icon name="whatsapp" size={18} />
      </a>
    </div>
  </section>

  <ShareBar
    path={path}
    title={s.title}
    text={s.metaDescription}
    label={labels.shareLabel}
    campaign="service"
    variant="card"
  />
</BaseLayout>
