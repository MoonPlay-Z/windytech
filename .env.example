# Astro (servidor Node en Render)
NODE_ENV=production
PUBLIC_SITE_URL=https://windytech.studio

# Base de datos (Neon PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host/dbname?sslmode=require
SESSION_SECRET=change-this-to-a-secure-random-string

# Auth
ADMIN_BOOTSTRAP_EMAIL=admin@windytech.studio
ADMIN_BOOTSTRAP_PASSWORD=change-this-password

# Cloudinary (opcional, para subir imágenes desde el panel)
PUBLIC_CLOUDINARY_CLOUD_NAME=cxy5wtgr
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
RESEND_API_KEY=your_resend_key
ADMIN_NOTIFICACION_EMAIL=hola@windytech.studio

# eBay (importar productos del catálogo de eBay)
# Con CLIENT_ID + CLIENT_SECRET basta para buscar e importar (token de
# aplicación). EBAY_REFRESH_TOKEN solo hace falta para publicar en eBay.
EBAY_CLIENT_ID=JuanAlfo-windytec-SBX-fd0b0f597-46578fc8
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=a2eda494-bd55-4014-9d6b-d2afc49ccfe4
EBAY_REFRESH_TOKEN=
EBAY_SANDBOX=true
EBAY_REDIRECT_URI=Juan_Alfonso_Ar-JuanAlfo-windyt-zbjsplbj
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope/sell.item
