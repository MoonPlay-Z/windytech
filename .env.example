# Astro (servidor Node en Render)
NODE_ENV=production
PUBLIC_SITE_URL=https://windytech.studio

# Base de datos (Neon PostgreSQL)
DATABASE_URL=postgresql://usuario:password@host/dbname?sslmode=require
SESSION_SECRET=change-this-to-a-secure-random-string

# Auth
ADMIN_BOOTSTRAP_EMAIL=admin@windytech.studio
ADMIN_BOOTSTRAP_PASSWORD=change-this-password

# Cloudinary (opcional, para subir imágenes desde el panel)
PUBLIC_CLOUDINARY_CLOUD_NAME=cxy5wtgr
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
RESEND_API_KEY=your_resend_key
ADMIN_NOTIFICACION_EMAIL=hola@windytech.studio
